       RowBox[{"r", 
        RowBox[{"(", 
         RowBox[{"r", "-", 
          RowBox[{"2", 
           RowBox[{"MassFuncInside", "[", "r", "]"}]}]}], ")"}]}]], ")"}]}]}],
    ";"}]}]], "Input",
