Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Phi", " ", "differential", " ", "equation", " ", "for", " ", "metric"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dPhidrMetric", "[", 
     RowBox[{"r_", ",", " ", "Pressure_"}], "]"}], " ", ":=", " ", 
    RowBox[{"(", 
     FractionBox[
      RowBox[{
       RowBox[{"MassFuncInside", "[", "r", "]"}], " ", "+", " ", 
       RowBox[{"4", " ", "Pi", " ", "Pressure", " ", 
        SuperscriptBox["r", "3"]}]}], 
      RowBox[{"r", 
       RowBox[{"(", 
        RowBox[{"r", "-", 
         RowBox[{"2", 
          RowBox[{"MassFuncInside", "[", "r", "]"}]}]}], ")"}]}]], ")"}]}], 
