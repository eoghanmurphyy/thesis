        RowBox[{"m", ",", " ", "rbar", ",", " ", "ur", ",", " ", "uphi"}], 
        "]"}], ",", " ", 
       RowBox[{"rbar", " ", "<", "rbarStar"}]}], "}"}]}], 
    "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.982934785334825*^9, 3.982934792910776*^9}},
