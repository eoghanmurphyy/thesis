Cell[CellGroupData[{

Cell["Average, physical energy loss per orbit N/A", "Subsection",
 CellChangeTimes->{{3.982908621407299*^9, 3.982908628893798*^9}, {
  3.982988522570265*^9, 
  3.9829885238956738`*^9}},ExpressionUUID->"21e6006f-e999-48cd-ba1e-\
0859835c353e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dEdtAvg", "[", 
   RowBox[{"m_", ",", "M_", ",", "a_", ",", "e_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"32", " ", 
       RowBox[{"m", "^", "2"}], " ", 
       RowBox[{"M", "^", "3"}]}], ")"}]}], "/", 
    RowBox[{"(", 
     RowBox[{"5", " ", 
      RowBox[{"a", "^", "5"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"e", "^", "2"}]}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"7", "/", "2"}], ")"}]}]}], ")"}]}], "*", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"73", "/", "24"}], ")"}], " ", 
      RowBox[{"e", "^", "2"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"37", "/", "96"}], ")"}], " ", 
      RowBox[{"e", "^", "4"}]}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.982908695319152*^9, 3.982908695319168*^9}},
 CellLabel->
  "In[199]:=",ExpressionUUID->"740cba26-c5ae-4203-8c6e-96d9bf940601"],

Cell["\<\
Need formulae for M[t]? Although accretion is very small. a(t) and e(t)\
\>", "Text",
 CellChangeTimes->{{3.982908944388515*^9, 
  3.982908980562503*^9}},ExpressionUUID->"2bbed891-f2d4-466b-8c12-\
503fa0ead232"]
}, Open  ]]
}, Open  ]],

