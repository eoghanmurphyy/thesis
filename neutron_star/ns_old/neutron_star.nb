Cell[CellGroupData[{

Cell["\<\
I messed up coordinate transforms here, that\[CloseCurlyQuote]s why the \
numbers were off.\
\>", "Subsubsection",
 CellChangeTimes->{{3.982992994816882*^9, 3.982993001600924*^9}, {
  3.983077503145376*^9, 
  3.983077517993267*^9}},ExpressionUUID->"0c1c058a-1c99-4b39-8fc7-\
ed7df267a80f"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"DERalpha", "[", 
     RowBox[{"rbarofrOutside", "[", "RStar", "]"}], "]"}], " ", "//", 
    RowBox[{"N", " ", 
     RowBox[{"(*", 
      RowBox[{
      "Think", " ", "I", " ", "am", " ", "making", " ", "a", " ", "mess", " ",
        "of", " ", "coordinate", " ", "tranforms", " ", "here", " ", "as", " ",
        "they", " ", "are", " ", "the", " ", "same", " ", "above", " ", "and",
        " ", "in", " ", "the", " ", "graph"}], "*)"}], "\[IndentingNewLine]", 
     
     RowBox[{"DERalphaIns", "[", 
      RowBox[{"rbarofrInside", "[", "RStar", "]"}], "]"}]}]}], " ", "//", 
   "N"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "More", " ", "or", " ", "less", " ", "continuous", " ", "now", " ", "but", 
    " ", "not", " ", "exact"}], "*)"}], "*)"}]], "Input",
 CellChangeTimes->{{3.9823939442118273`*^9, 3.982393977707012*^9}, {
  3.982404766394513*^9, 3.9824047783386183`*^9}, {3.9828186607982807`*^9, 
  3.982818662246258*^9}, {3.9829923768218307`*^9, 3.982992398981353*^9}, {
  3.982992978049282*^9, 3.982992980769491*^9}},
 CellLabel->"In[79]:=",ExpressionUUID->"1b09fadb-cc7e-43cd-be24-827d0ba30cfb"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"diff", " ", "=", " ", 
   RowBox[{"Abs", "[", 
    RowBox[{"1", " ", "-", " ", 
     FractionBox[
      RowBox[{"DERalphaIns", "[", 
       RowBox[{"rbarofrInside", "[", "RStar", "]"}], "]"}], 
      RowBox[{"DERalpha", "[", 
       RowBox[{"rbarofrOutside", "[", "RStar", "]"}], "]"}]]}], "]"}]}], 
  "*)"}]], "Input",
