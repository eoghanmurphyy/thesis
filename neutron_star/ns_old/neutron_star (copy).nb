            RowBox[{"r", ",", 
             RowBox[{"Pressure", "[", "r", "]"}]}], "]"}], "/", 
           RowBox[{"drhodr", "[", "r", "]"}]}], "]"}], ",", 
         RowBox[{"rbar", "<", "cutoffIso"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"aFirst", "[", "cutoffIso", "]"}], ",", " ", 
