  3.982908904907382*^9, 
  3.982908909299267*^9}},ExpressionUUID->"e87e1c13-79c0-4fb1-8210-\
1784f82d5ad8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dLdtOutside", "[", 
   RowBox[{"m_", ",", " ", "rbar_", ",", " ", "ur_", ",", " ", "uphi_"}], 
   "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", "=", 
      RowBox[{"rofrbarOutside", "[", "rbar", "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     SuperscriptBox["r", "2"], " ", 
     RowBox[{"FRRphi", "[", 
      RowBox[{"m", ",", " ", "rbar", ",", " ", "ur", ",", " ", "uphi"}], 
      "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dLdtInside", "[", 
   RowBox[{"m_", ",", " ", "rbar_", ",", " ", "ur_", ",", " ", "uphi_"}], 
   "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", "=", 
      RowBox[{"rofrbarInside", "[", "rbar", "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     SuperscriptBox["r", "2"], " ", 
     RowBox[{"FRRphiIns", "[", 
      RowBox[{"m", ",", " ", "rbar", ",", " ", "ur", ",", " ", "uphi"}], 
      "]"}]}]}], "]"}]}]}], "Input",
