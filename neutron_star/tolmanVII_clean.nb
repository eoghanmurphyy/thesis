Cell[BoxData[{
 RowBox[{
  RowBox[{"rbarNumIn", " ", "=", " ", 
   RowBox[{"rbar", " ", "/.", " ", "solIn"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"urNumIn", " ", "=", " ", 
   RowBox[{"ur", " ", "/.", " ", "solIn"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phiNumIn", " ", "=", " ", 
   RowBox[{"phi", " ", "/.", " ", "solIn"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uphiNumIn", " ", "=", " ", 
   RowBox[{"uphi", " ", "/.", " ", "solIn"}]}], ";"}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"massNumIn", " ", "=", " ", 
    RowBox[{"mass", " ", "/.", " ", "solIn"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"tFinish", " ", "=", " ", 
  RowBox[{
   RowBox[{"rbarNumIn", "[", "\"\<Domain\>\"", "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tSurface", "=", 
   RowBox[{"t", "/.", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"rbarNumIn", "[", "t", "]"}], "==", "rbarStar"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "10", ",", "10", ",", "tFinish"}], "}"}]}], 
     "]"}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"rbarNumIn", "[", "t", "]"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"phiNumIn", "[", "t", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"y", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"rbarNumIn", "[", "t", "]"}], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"phiNumIn", "[", "t", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"orbit2D", "=", 
    RowBox[{"ParametricPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "[", "t", "]"}], ",", 
        RowBox[{"y", "[", "t", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "t0", ",", 
        RowBox[{"0.999", " ", "tFinish"}]}], "}"}], ",", 
      RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Blue"}], "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Automatic", " ", "scale", " ", "makes", " ", "the", " ", "aces", " ", 
    "the", " ", "same", " ", "scale"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"centralBody", "=", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"GrayLevel", "[", "0.9", "]"}], ",", 
      RowBox[{"Disk", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", "rbarStar"}], "]"}]}], "}"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"centralBody", ",", " ", "orbit2D", ",", 
