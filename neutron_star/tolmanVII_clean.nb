 CellLabel->"In[49]:=",ExpressionUUID->"e3b40a58-b0b8-4f9d-a563-1194a29ee839"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Exterior derivative in terms of r", \
"Subsubsection"]], "Subsubsection",
 CellChangeTimes->{{3.982393538336166*^9, 3.982393542438478*^9}, {
  3.9828181906973343`*^9, 3.982818190865354*^9}, {3.9830773769303427`*^9, 
  3.9830773788341837`*^9}},ExpressionUUID->"7852429f-1034-47bc-b847-\
f1c2c4989ad6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"DER\[Alpha]Outsiderbardummy", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Derivative", "[", "1", "]"}], "[", "\[Alpha]", "]"}], "[", 
    "rbar", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DER\[Alpha]Outsiderbar", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", 
        FractionBox["1", 
         RowBox[{"2", " ", "rbar"}]]}], 
       RowBox[{"2", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", 
           FractionBox["1", 
            RowBox[{"2", " ", "rbar"}]]}], ")"}], "2"], " ", 
        SuperscriptBox["rbar", "2"]}]], "+", 
      FractionBox["1", 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox["1", 
           RowBox[{"2", " ", "rbar"}]]}], ")"}], " ", 
        SuperscriptBox["rbar", "2"]}]]}], " ", ")"}], "/.", " ", 
    RowBox[{"rbar", " ", "->", " ", 
     RowBox[{"rbarofrOutside", "[", "r", "]"}]}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "More", " ", "accurate", " ", "subbing", " ", "in", " ", "after", " ", 
    "for", " ", "rbar", " ", 
    RowBox[{"maybe", "?"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"drbardr", "[", "r_", "]"}], " ", ":=", " ", 
  RowBox[{
   FractionBox[
    RowBox[{"rbarofrOutside", "[", "r", "]"}], "r"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox[
       RowBox[{"2", "M"}], "r"]}], ")"}], 
    RowBox[{"-", 
     FractionBox["1", "2"]}]]}]}]}], "Input",
 CellChangeTimes->{{3.982393741125156*^9, 3.9823937448050137`*^9}, {
