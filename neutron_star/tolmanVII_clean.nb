Cell[CellGroupData[{

Cell["Setting the Initial conditions", "Subsection",
 CellChangeTimes->{{3.980417374617618*^9, 
  3.980417378785927*^9}},ExpressionUUID->"acfdbf8c-1e58-4e68-b263-\
d925c1af57b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"we", " ", "start", " ", "at", " ", "rbarStar"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"phi0", " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Einf", " ", "=", " ", 
    RowBox[{
     RowBox[{"InitialEnergyAtInfinity", "[", "vinf", "]"}], "//", "N"}]}], "\[IndentingNewLine]",
    " ", 
   RowBox[{
    RowBox[{"u", " ", "=", " ", 
     RowBox[{"umagE", "[", 
      RowBox[{"Einf", ",", " ", "rbarStar"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ImpactAngle", " ", "=", " ", 
     RowBox[{".85", 
      RowBox[{"Pi", "/", "2"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"In", " ", "radians"}], ",", " ", 
     RowBox[{
     "measured", " ", "from", " ", "center", " ", "of", " ", "star", " ", 
      "to", " ", "the", " ", "position", " ", "of", " ", "particle"}], ",", 
     " ", 
     RowBox[{"in", " ", "unit", " ", "circle", " ", "fashion"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"1.5", 
        FractionBox["Pi", "4"], " ", "\[Eta]"}], " ", "=", " ", 
       RowBox[{
        SuperscriptBox["10", "3"], " ", "is", " ", "nice"}]}], "*)"}], 
     RowBox[{
      RowBox[{"pi", "/", "2"}], " ", "corresponds", " ", "to", " ", "grazing",
       " ", "the", " ", "star", " ", "as", " ", "it", " ", "enters", " ", 
      "and", " ", "0", " ", "corresponds", " ", "to", " ", "a", " ", "radial",
       " ", "drop"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ur0", " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "u"}], "*", 
      RowBox[{"Cos", "[", "ImpactAngle", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AngularMomentumUphi0", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", "rbarStar", ")"}], 
      RowBox[{"(", "u", ")"}], " ", 
      RowBox[{"Sin", "[", "ImpactAngle", "]"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9804173808295593`*^9, 3.9804174607879868`*^9}, {
