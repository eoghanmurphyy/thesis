Cell[BoxData[{
 RowBox[{
  RowBox[{"t0", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tEnd", "=", "140000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", "=", "0.005"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Reset", " ", "currentTime", " ", "and", " ", "currentR"}], "*)"}], 
  RowBox[{
   RowBox[{"currentTime", "=", "t0"}], ";"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"currentR", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"999", "/", "1000"}], ")"}], " ", "rbarStar"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Monitor", "[", 
  RowBox[{
   RowBox[{"solIn", "=", 
    RowBox[{
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"rbar", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"Piecewise", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"drBardt", "[", 
                RowBox[{
                 RowBox[{"rbar", "[", "t", "]"}], ",", 
                 RowBox[{"ur", "[", "t", "]"}], ",", 
                 RowBox[{"uphi", "[", "t", "]"}]}], "]"}], ",", 
               RowBox[{
                RowBox[{"rbar", "[", "t", "]"}], ">=", "rbarStar"}]}], "}"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"drBardtInside", "[", 
                RowBox[{
                 RowBox[{"rbar", "[", "t", "]"}], ",", 
                 RowBox[{"ur", "[", "t", "]"}], ",", 
                 RowBox[{"uphi", "[", "t", "]"}]}], "]"}], ",", 
               RowBox[{
                RowBox[{"rbar", "[", "t", "]"}], "<", "rbarStar"}]}], "}"}]}],
             "}"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"ur", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"Piecewise", "[", 
           RowBox[{"{", 
