Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"WhenEvent", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"rbar", "[", "t", "]"}], " ", "<", " ", "rbarStar"}], " ", "&&",
      " ", 
     RowBox[{
      RowBox[{"Mach", "[", 
       RowBox[{
        RowBox[{"rbar", "[", "t", "]"}], ",", " ", 
        RowBox[{"ur", "[", "t", "]"}], ",", " ", 
        RowBox[{"uphi", "[", "t", "]"}]}], "]"}], " ", "<", " ", "2"}]}], ",",
     " ", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"NearSubsonicTime", ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", 
        RowBox[{"rbar", "[", "t", "]"}]}], "}"}]}], "]"}]}], "]"}], 
