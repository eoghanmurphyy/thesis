Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"hData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"hplus", "[", "t", "]"}], "-", 
      RowBox[{"I", "*", 
       RowBox[{"hcross", "[", "t", "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "50", ",", 
       RowBox[{".9", " ", "tFinish"}], ",", "0.1"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dt", "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fs", "=", 
   RowBox[{"1", "/", "dt"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"Length", "[", "hData", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tM", "=", 
    RowBox[{"6.89589", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "6"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"SI", " ", "conversion", " ", "for", " ", "1.4", " ", "M_sun"}], 
   "*)"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ftData", "=", 
    RowBox[{"Fourier", "[", 
     RowBox[{"hData", ",", 
      RowBox[{"FourierParameters", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"This", " ", "line", " ", "is", " ", "the", " ", 
    RowBox[{"fix", ":", 
     RowBox[{
     "it", " ", "scales", " ", "the", " ", "axis", " ", "to", " ", "Hz"}]}]}],
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"frequencies", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"i", "-", "1"}], ")"}], "*", 
         RowBox[{"fs", "/", "n"}]}], ")"}], "/", "tM"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{
         RowBox[{"Floor", "[", 
          RowBox[{"n", "/", "2"}], "]"}], "+", "1"}]}], "}"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"powerSpectrum", "=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"ftData", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", 
        RowBox[{"Length", "[", "frequencies", "]"}]}], "]"}], "]"}], "]"}], "^",
     "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"peakIndex", "=", 
   RowBox[{"First", "[", 
    RowBox[{"Ordering", "[", 
     RowBox[{"powerSpectrum", ",", 
      RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"prominentFrequency", "=", 
    RowBox[{"frequencies", "[", 
     RowBox[{"[", "peakIndex", "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<The most prominent GW frequency is (Hz): \>\"", ",", 
    "prominentFrequency"}], "]"}], ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.9852562352513323`*^9, 3.985256235251389*^9}, {
