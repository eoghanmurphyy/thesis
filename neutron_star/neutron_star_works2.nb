Cell[BoxData[
 RowBox[{
  RowBox[{"Isorho", "[", "rbar_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"rofrbarInside", "[", "rbar", "]"}]}], "}"}], ",", " ", 
    RowBox[{"rho0", 
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"alphaaa", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["r", "RStar"], ")"}], "2"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"alphaaa", "-", "1"}], ")"}], 
        SuperscriptBox[
         RowBox[{"(", 
