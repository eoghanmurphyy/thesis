Cell[BoxData[{
 RowBox[{
  RowBox[{"drbardr", "[", 
   RowBox[{"rbar_", ",", " ", "r_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   FractionBox["rbar", "r"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox[
       RowBox[{"2", 
        RowBox[{"MassFuncInside", "[", "r", "]"}]}], "r"]}], ")"}], 
    RowBox[{"-", 
     FractionBox["1", "2"]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"drdrbar", "[", "rbar_", "]"}], " ", ":=", " ", 
  RowBox[{
   FractionBox[
    RowBox[{"rofrbarInside", "[", "rbar", "]"}], "rbar"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox[
       RowBox[{"2", 
        RowBox[{"MassFuncInside", "[", 
         RowBox[{"rofrbarInside", "[", "rbar", "]"}], "]"}]}], 
       RowBox[{"rofrbarInside", "[", "rbar", "]"}]]}], ")"}], 
    FractionBox["1", "2"]]}]}]}], "Input",
 CellChangeTimes->{{3.982309801432266*^9, 3.982309835904133*^9}, {
  3.982392570830728*^9, 3.982392581679675*^9}},
 CellLabel->
