Cell[BoxData[
 RowBox[{
  RowBox[{"hData", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"hplus", "[", "t", "]"}], " ", "-", " ", 
      RowBox[{"I", "*", 
       RowBox[{"hcross", "[", "t", "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "300", ",", " ", "tFinish", ",", " ", "0.1"}], 
      "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.985180940848249*^9, {3.985181018831727*^9, 3.985181070511293*^9}, {
   3.985182182263689*^9, 3.985182183887426*^9}, {3.985182229359412*^9, 
   3.985182245743064*^9}},
 CellLabel->
  "In[268]:=",ExpressionUUID->"940d8819-a4d3-495f-a435-0fd4749f3baa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Ensure", " ", "your", " ", "time", " ", "step", " ", "dt", " ", "is", " ",
     "defined", " ", "based", " ", "on", " ", "your", " ", "data", " ", 
    "generation"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"dt", "=", "0.1"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Example", " ", "value"}], ";", 
     RowBox[{
     "replace", " ", "with", " ", "your", " ", "actual", " ", "time", " ", 
      "step"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"fs", "=", 
     RowBox[{"1", "/", "dt"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Sampling", " ", "frequency"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{"Length", "[", "hData", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.985180730339933*^9, 3.9851807303399487`*^9}, {
  3.9851820713043222`*^9, 3.985182072136056*^9}, {3.9851821027119637`*^9, 
  3.985182104160172*^9}, {3.98518218588763*^9, 3.98518218619163*^9}, {
  3.985182233239079*^9, 3.985182246678986*^9}},
 CellLabel->
  "In[269]:=",ExpressionUUID->"fddee5d6-68ac-433d-bb80-b9eb25cad7c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Compute", " ", "the", " ", "DFT"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ftData", "=", 
     RowBox[{"Fourier", "[", 
      RowBox[{"hData", ",", 
       RowBox[{"FourierParameters", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "corresponding", " ", "frequency", " ", 
     "bins"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Only", " ", "the", " ", "first", " ", "half", " ", "of", " ", "the", " ",
      "data", " ", "is", " ", "needed", " ", "for", " ", "physical", " ", 
     "frequencies", " ", 
     RowBox[{"(", "Nyquist", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"frequencies", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", "-", "1"}], ")"}], "*", 
        RowBox[{"fs", "/", 
         RowBox[{"(", 
          RowBox[{"n", "*", "7", " ", 
           SuperscriptBox["10", 
            RowBox[{"-", "6"}]]}], ")"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{
          RowBox[{"Floor", "[", 
           RowBox[{"n", "/", "2"}], "]"}], "+", "1"}]}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"powerSpectrum", "=", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"ftData", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "frequencies", "]"}]}], "]"}], "]"}], "]"}], 
      "^", "2"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.985180737299685*^9, 3.9851807372997026`*^9}, {
   3.9851808077136374`*^9, 3.985180810850202*^9}, 3.985181420221504*^9, {
   3.9851831252077847`*^9, 3.985183127839613*^9}},
 CellLabel->
  "In[301]:=",ExpressionUUID->"cbee324e-b319-4692-b74d-841d5ebe15c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Find", " ", "the", " ", "index", " ", "of", " ", "the", " ", "peak"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"peakIndex", "=", 
     RowBox[{"First", "[", 
      RowBox[{"Ordering", "[", 
       RowBox[{"powerSpectrum", ",", 
        RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Extract", " ", "the", " ", "actual", " ", "frequency", " ", "value"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"prominentFrequency", "=", 
     RowBox[{"frequencies", "[", 
      RowBox[{"[", "peakIndex", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<The most prominent GW frequency is: \>\"", ",", 
      "prominentFrequency"}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.985180748715535*^9, 3.9851807487155523`*^9}, {
  3.9851830957845507`*^9, 3.985183117632141*^9}},
