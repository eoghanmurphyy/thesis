  RowBox[{"Piecewise", "[", "\[IndentingNewLine]", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"hxOutside", "[", 
        RowBox[{
        "d", ",", " ", "m", ",", " ", "rbar", ",", " ", "ur", ",", " ", 
         "uphi", ",", " ", "phi"}], "]"}], ",", " ", 
