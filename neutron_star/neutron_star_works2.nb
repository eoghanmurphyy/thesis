  3.982910492030881*^9}},ExpressionUUID->"d20c97c2-8d4a-4785-9dda-\
483ee80aca99"],

Cell[BoxData[
 RowBox[{
  RowBox[{"hxInside", "[", 
   RowBox[{
   "d_", ",", " ", "m_", ",", " ", "rbar_", ",", " ", "ur_", ",", " ", 
    "uphi_", ",", " ", "phi_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"rofrbarInside", "[", "rbar", "]"}]}], ",", " ", "rd", ",", 
      " ", "phid"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rd", " ", "=", " ", 
      RowBox[{"drBardtInside", "[", 
       RowBox[{"rbar", ",", "ur", ",", "uphi"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"phid", " ", "=", " ", 
      RowBox[{"dphidtInside", "[", 
       RowBox[{"rbar", ",", "ur", ",", "uphi"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       FractionBox[
        RowBox[{
         RowBox[{"-", "2"}], "m"}], "d"], ")"}], 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"MassFuncInside", "[", "r", "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"2", " ", "phi"}], "]"}]}], "r"], " ", "-", " ", 
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"rd", " ", 
            RowBox[{"Sin", "[", "phi", "]"}]}], " ", "+", " ", 
           RowBox[{"r", " ", "phid", " ", 
            RowBox[{"Cos", "[", "phi", "]"}]}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"rd", " ", 
            RowBox[{"Cos", "[", "phi", "]"}]}], " ", "-", " ", 
           RowBox[{"r", " ", "phid", " ", 
            RowBox[{"Sin", "[", "phi", "]"}]}]}], ")"}]}]}], ")"}]}]}]}], 
