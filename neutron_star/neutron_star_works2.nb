Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"hData", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"hplus", "[", "t", "]"}], "-", 
      RowBox[{"I", "*", 
       RowBox[{"hcross", "[", "t", "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "tFinish", ",", "0.1"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dt", "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fs", "=", 
   RowBox[{"1", "/", "dt"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"Length", "[", "hData", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tM", "=", 
    RowBox[{"6.89589", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "6"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"SI", " ", "conversion", " ", "for", " ", "1.4", " ", "M_sun"}], 
   "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ftData", "=", 
    RowBox[{"Fourier", "[", 
     RowBox[{"hData", ",", 
      RowBox[{"FourierParameters", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"This", " ", "line", " ", "is", " ", "the", " ", 
    RowBox[{"fix", ":", 
     RowBox[{
     "it", " ", "scales", " ", "the", " ", "axis", " ", "to", " ", "Hz"}]}]}],
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"frequencies", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"i", "-", "1"}], ")"}], "*", 
         RowBox[{"fs", "/", "n"}]}], ")"}], "/", "tM"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{
         RowBox[{"Floor", "[", 
          RowBox[{"n", "/", "2"}], "]"}], "+", "1"}]}], "}"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"powerSpectrum", "=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"ftData", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", 
        RowBox[{"Length", "[", "frequencies", "]"}]}], "]"}], "]"}], "]"}], "^",
     "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"peakIndex", "=", 
   RowBox[{"First", "[", 
    RowBox[{"Ordering", "[", 
     RowBox[{"powerSpectrum", ",", 
      RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"prominentFrequency", "=", 
    RowBox[{"frequencies", "[", 
     RowBox[{"[", "peakIndex", "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<The most prominent GW frequency is (Hz): \>\"", ",", 
    "prominentFrequency"}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.985269047596627*^9, 3.985269109614758*^9}, {
  3.9852691910060387`*^9, 3.985269191166305*^9}},
