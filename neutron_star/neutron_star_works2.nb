Cell[CellGroupData[{

Cell["Making the derivative of alpha continuous", "Subsection",
 CellChangeTimes->{{3.982818100593948*^9, 3.982818108849741*^9}, {
  3.983077314114069*^9, 
  3.983077345498435*^9}},ExpressionUUID->"7889f249-5755-4f46-9fbd-\
ffad4f4b9ba9"],

Cell[CellGroupData[{

Cell["Interior derivative in terms of r", "Subsubsection",
 CellChangeTimes->{{3.982818175953421*^9, 
  3.982818182321394*^9}},ExpressionUUID->"37df973b-d829-4484-b6b0-\
dce6c1741723"],

Cell["Doing things in r first as this is more analytic", "Text",
 CellChangeTimes->{{3.982818131907432*^9, 
  3.982818140641671*^9}},ExpressionUUID->"21fa02b9-70b0-45ed-8ecc-\
84b5dd44a49e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dPhidrMetric", "[", "r_", "]"}], " ", ":=", " ", 
  RowBox[{"(", 
   FractionBox[
    RowBox[{
     RowBox[{"MassFuncInside", "[", "r", "]"}], " ", "+", " ", 
     RowBox[{"4", " ", "Pi", " ", 
      RowBox[{"Pressure", "[", "r", "]"}], " ", 
      SuperscriptBox["r", "3"]}]}], 
    RowBox[{"r", 
     RowBox[{"(", 
      RowBox[{"r", "-", 
       RowBox[{"2", 
        RowBox[{"MassFuncInside", "[", "r", "]"}]}]}], ")"}]}]], 
   ")"}]}]], "Input",
 CellChangeTimes->{{3.982393502718885*^9, 3.9823935097345247`*^9}, {
  3.982399278079626*^9, 3.982399279215176*^9}},
 CellLabel->
  "In[104]:=",ExpressionUUID->"e2bd8d70-e245-4ff9-a1ae-69ad0a54f3c9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"alpha", "[", "r_", "]"}], " ", ":=", " ", 
  RowBox[{"Exp", "[", 
   RowBox[{"PhiMetric", "[", "r", "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DERalphaIns", "[", "r_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"dPhidrMetric", "[", "r", "]"}], " ", 
   RowBox[{"alpha", "[", "r", "]"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Something", " ", "analytic", " ", "times", " ", "a", " ", "numerical", " ",
      "integral"}], "*)"}]}]}]}], "Input",
 CellChangeTimes->{{3.982393421464878*^9, 3.982393486503831*^9}, {
  3.982393520726775*^9, 3.982393525326456*^9}, {3.982393731557509*^9, 
  3.982393731861285*^9}, {3.9828181498500853`*^9, 3.982818160353858*^9}, {
  3.983077365218891*^9, 3.983077371586699*^9}},
 CellLabel->
  "In[105]:=",ExpressionUUID->"c9bd4a4b-6693-4faf-86e2-4b16e1e55058"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Exterior derivative in terms of r", \
"Subsubsection"]], "Subsubsection",
 CellChangeTimes->{{3.982393538336166*^9, 3.982393542438478*^9}, {
  3.9828181906973343`*^9, 3.982818190865354*^9}, {3.9830773769303427`*^9, 
  3.9830773788341837`*^9}},ExpressionUUID->"811fd4c9-1185-4934-9262-\
0fc20af4fc94"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"DER\[Alpha]Outsiderbardummy", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Derivative", "[", "1", "]"}], "[", "\[Alpha]", "]"}], "[", 
    "rbar", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DER\[Alpha]Outsiderbar", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"1", "-", 
        FractionBox["1", 
         RowBox[{"2", " ", "rbar"}]]}], 
       RowBox[{"2", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", 
           FractionBox["1", 
            RowBox[{"2", " ", "rbar"}]]}], ")"}], "2"], " ", 
        SuperscriptBox["rbar", "2"]}]], "+", 
      FractionBox["1", 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox["1", 
           RowBox[{"2", " ", "rbar"}]]}], ")"}], " ", 
        SuperscriptBox["rbar", "2"]}]]}], " ", ")"}], "/.", " ", 
    RowBox[{"rbar", " ", "->", " ", 
     RowBox[{"rbarofrOutside", "[", "r", "]"}]}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "More", " ", "accurate", " ", "subbing", " ", "in", " ", "after", " ", 
    "for", " ", "rbar", " ", 
    RowBox[{"maybe", "?"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"drbardr", "[", "r_", "]"}], " ", ":=", " ", 
  RowBox[{
   FractionBox[
    RowBox[{"rbarofrOutside", "[", "r", "]"}], "r"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox[
       RowBox[{"2", "M"}], "r"]}], ")"}], 
    RowBox[{"-", 
     FractionBox["1", "2"]}]]}]}]}], "Input",
 CellChangeTimes->{{3.982393741125156*^9, 3.9823937448050137`*^9}, {
   3.982393806669126*^9, 3.982393871731821*^9}, {3.982398059609561*^9, 
   3.982398156392806*^9}, {3.982398204816495*^9, 3.9823982572471333`*^9}, {
   3.98239830059966*^9, 3.9823983187834263`*^9}, {3.9823984157983627`*^9, 
   3.982398430038177*^9}, {3.9823985107016172`*^9, 3.982398518949471*^9}, 
   3.9830770623171263`*^9},
 CellLabel->
  "In[107]:=",ExpressionUUID->"f9757533-d2f2-4d48-9cc6-626b537312eb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DERalpha", "[", "r_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"drbardr", "[", "r", "]"}], "  ", 
   RowBox[{"DER\[Alpha]Outsiderbar", "[", "r", "]"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Chain", " ", "rule"}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.98239376174957*^9, 3.982393776652556*^9}, {
  3.982393874747727*^9, 3.9823938859633703`*^9}, {3.982398527717649*^9, 
  3.9823985282849894`*^9}, {3.982398714083644*^9, 3.982398718363468*^9}, {
