Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<MaTeX`\>\"", "]"}], "\n", "\[IndentingNewLine]", 
  
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Final", " ", "LaTeX", " ", "Preamble", " ", "Configuration"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetOptions", "[", 
    RowBox[{"MaTeX", ",", 
     RowBox[{"\"\<Preamble\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\\\\usepackage{amsmath, amsfonts, amssymb, amsthm, \
bm}\>\"", ",", "\"\<\\\\newcommand{\\\\rb}{\\\\bar{r}}\>\"", 
        ",", "\"\<\\\\providecommand{\\\\e}[1]{\\\\ensuremath{\\\\times \
10^{#1}}}\>\""}], "}"}]}]}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "The", " ", "Master", " ", "Piecewise", " ", "Plotting", " ", 
    "Function"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ThesisPiecewisePlot", "[", 
   RowBox[{
   "fInside_", ",", "fOutside_", ",", "rStar_", ",", "rMax_", ",", 
    "fileName_String", ",", 
    RowBox[{"yLabel_", ":", "\"\<\\\\alpha(\\\\rb)\>\""}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pIn", ",", "pOut", ",", "blue", ",", "red", ",", "finalPlot"}], 
     "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{"Define", " ", "Thesis", " ", "Colors"}], "*)"}], 
    RowBox[{
     RowBox[{"blue", "=", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.12", ",", "0.47", ",", "0.71"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"red", "=", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.89", ",", "0.10", ",", "0.11"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Create", " ", "the", " ", "two", " ", "branches"}], "*)"}], 
     RowBox[{"pIn", "=", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"fInside", "[", "r", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "0", ",", "rStar"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"{", 
          RowBox[{"blue", ",", 
           RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "}"}]}], ",", 
        RowBox[{"Exclusions", "->", "None"}], ",", 
        RowBox[{"PlotPoints", "->", "200"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pOut", "=", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"fOutside", "[", "r", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "rStar", ",", "rMax"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"{", 
          RowBox[{"red", ",", 
           RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "}"}]}], ",", 
        RowBox[{"Exclusions", "->", "None"}], ",", 
        RowBox[{"PlotPoints", "->", "200"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Assemble", " ", "the", " ", "Graphic"}], "*)"}], 
     RowBox[{"finalPlot", "=", 
      RowBox[{"Show", "[", 
       RowBox[{"pIn", ",", "pOut", ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"Axes", "->", "False"}], ",", 
        RowBox[{"FrameStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Black", ",", 
           RowBox[{"AbsoluteThickness", "[", "1", "]"}]}], "]"}]}], ",", 
        RowBox[{"FrameTicksStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Black", ",", "11"}], "]"}]}], ",", 
        RowBox[{"(*", 
         RowBox[{"Ticks", ":", 
          RowBox[{
           RowBox[{"Standard", " ", "numbers"}], "+", 
           RowBox[{"your", " ", "rStar", " ", "label"}]}]}], "*)"}], 
        RowBox[{"FrameTicks", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Automatic", ",", "Automatic"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Append", "[", 
              RowBox[{
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"i", ",", 
                   RowBox[{"MaTeX", "[", 
                    RowBox[{
                    RowBox[{"ToString", "[", "i", "]"}], ",", 
                    RowBox[{"FontSize", "->", "12"}]}], "]"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "0", ",", "rMax", ",", "1"}], "}"}]}], 
                "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"rStar", ",", 
                 RowBox[{"MaTeX", "[", 
                  RowBox[{"\"\<\\\\rb^*\>\"", ",", 
                   RowBox[{"FontSize", "->", "14"}]}], "]"}], ",", 
