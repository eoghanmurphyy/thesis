Cell[BoxData[{
 RowBox[{
  RowBox[{"drbardr", "[", 
   RowBox[{"rbar_", ",", " ", "r_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   FractionBox["rbar", "r"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox[
       RowBox[{"2", 
        RowBox[{"MassFuncInside", "[", "r", "]"}]}], "r"]}], ")"}], 
    RowBox[{"-", 
