          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"10", ",", " ", "10000"}], "}"}], ",", " ", "All"}], 
            "}"}]}], ",", 
          RowBox[{"PlotRangePadding", "->", 
           RowBox[{"Scaled", "[", "0.02", "]"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fullPath", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"exportDirectory", ",", 
           RowBox[{"fileName", "<>", "\"\<.pdf\>\""}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{"fullPath", ",", "finalPlot", ",", "\"\<PDF\>\""}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Saved Linear Spectrum: \>\"", ",", "Red", ",", 
           "Bold"}], "]"}], ",", "fullPath"}], "]"}], ";", 
       "\[IndentingNewLine]", "finalPlot"}]}], "]"}]}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ThesisListPlotPeak", "[", 
     RowBox[{"data_", ",", "fileName_String", ",", 
      RowBox[{"yLabel_", ":", "\"\<Power\>\""}], ",", 
      RowBox[{"xLabel_", ":", "\"\<Frequency (Hz)\>\""}], ",", 
      RowBox[{"pRange_", ":", "All"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "finalPlot", ",", "fullPath", ",", "peakFreq", ",", "peakPower", ",", 
        "extras", ",", "ticks", ",", "xDivs", ",", "xRangeWidth"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "1.", " ", "Find", " ", "the", " ", "Peak", " ", "Automatically"}], 
       "*)"}], 
      RowBox[{"(*", 
       RowBox[{
       "data", " ", "is", " ", "assumed", " ", "to", " ", "be", " ", "a", " ",
         "list", " ", "of", " ", 
        RowBox[{"{", 
         RowBox[{"freq", ",", "power"}], "}"}]}], "*)"}], 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"peakFreq", ",", "peakPower"}], "}"}], "=", 
        RowBox[{"First", "@", 
         RowBox[{
          RowBox[{"SortBy", "[", 
           RowBox[{"data", ",", "Last"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "2.", " ", "Create", " ", "the", " ", "vertical", " ", "dashed", " ", 
         "line", " ", "and", " ", "a", " ", "dot", " ", "at", " ", "the", " ",
          "peak"}], "*)"}], 
       RowBox[{"extras", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"GrayLevel", "[", "0.4", "]"}], ",", "Dashed", ",", 
            RowBox[{"AbsoluteThickness", "[", "1", "]"}]}], "]"}], ",", 
          RowBox[{"InfiniteLine", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"peakFreq", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
          RowBox[{"Directive", "[", "Red", "]"}], ",", 
          RowBox[{"PointSize", "[", "Medium", "]"}], ",", 
          RowBox[{"Point", "[", 
           RowBox[{"{", 
            RowBox[{"peakFreq", ",", "peakPower"}], "}"}], "]"}]}], "}"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"3.", " ", "Logic", " ", "for", " ", "Ticks", " ", 
         RowBox[{"(", 
          RowBox[{
          "Handling", " ", "the", " ", "start", " ", "at", " ", "10", " ", 
           "and", " ", "labeling", " ", "the", " ", "peak"}], ")"}]}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"If", " ", "pRange", " ", "is", " ", "All"}], ",", 
         RowBox[{
          RowBox[{"we", " ", "use", " ", "the", " ", "data", " ", "limits"}], 
          ";", 
          RowBox[{"otherwise", " ", "use", " ", "pRange", " ", "limits"}]}]}],
         "*)"}], 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"vMin", ",", "vMax"}], "}"}], "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"pRange", "===", "All"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{"data", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{"Max", "[", 
             RowBox[{"data", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"pRange", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xRangeWidth", "=", 
        RowBox[{"vMax", "-", "vMin"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xDivs", "=", 
        RowBox[{"FindDivisions", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"vMin", ",", "vMax"}], "}"}], ",", "6"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Filter", " ", "out", " ", "auto"}], "-", 
         RowBox[{
         "ticks", " ", "too", " ", "close", " ", "to", " ", "the", " ", 
          "peak", " ", "label"}]}], "*)"}], 
       RowBox[{"xDivs", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"xDivs", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"#", "-", "peakFreq"}], "]"}], ">", 
            RowBox[{"0.10", "*", "xRangeWidth"}]}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ticks", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", "Automatic"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Union", "[", 
             RowBox[{"xDivs", ",", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{"peakFreq", ",", 
                 RowBox[{"MaTeX", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"ToString", "[", 
                    RowBox[{"Round", "[", 
                    RowBox[{"peakFreq", ",", "0.1"}], "]"}], "]"}], 
                    "<>", "\"\<\\\\text{ Hz}\>\""}], ",", 
                   RowBox[{"FontSize", "->", "$ThesisFontSize"}]}], "]"}]}], 
                "}"}], "}"}]}], "]"}], ",", "Automatic"}], "}"}]}], "}"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"finalPlot", "=", 
        RowBox[{"ListLinePlot", "[", 
         RowBox[{"data", ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"Axes", "->", "False"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", 
            RowBox[{"Red", ",", 
             RowBox[{"AbsoluteThickness", "[", "$ThesisThickness", "]"}]}], 
            "}"}]}], ",", 
          RowBox[{"FrameStyle", "->", "$FrameStyle"}], ",", 
          RowBox[{"FrameTicks", "->", "ticks"}], ",", 
          RowBox[{"FrameTicksStyle", "->", 
           RowBox[{"Directive", "[", 
            RowBox[{"Black", ",", "$ThesisTickSize"}], "]"}]}], ",", 
          RowBox[{"GridLines", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "peakFreq", "}"}], ",", "Automatic"}], "}"}]}], ",", 
          RowBox[{"GridLinesStyle", "->", "$GridStyle"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"MaTeX", "[", 
              RowBox[{"xLabel", ",", 
               RowBox[{"FontSize", "->", "$ThesisFontSize"}]}], "]"}], ",", 
             RowBox[{"MaTeX", "[", 
              RowBox[{"yLabel", ",", 
               RowBox[{"FontSize", "->", "$ThesisFontSize"}]}], "]"}]}], 
            "}"}]}], ",", 
          RowBox[{"ImageSize", "->", "$ThesisImageSize"}], ",", 
          RowBox[{"AspectRatio", "->", 
           RowBox[{"1", "/", "GoldenRatio"}]}], ",", 
          RowBox[{"PlotRange", "->", "pRange"}], ",", 
          RowBox[{"PlotRangePadding", "->", 
           RowBox[{"{", 
            RowBox[{"None", ",", 
             RowBox[{"Scaled", "[", "0.1", "]"}]}], "}"}]}], ",", 
          RowBox[{"Epilog", "->", "extras"}]}], " ", 
         RowBox[{"(*", 
          RowBox[{"Adds", " ", "the", " ", "dashed", " ", "line"}], "*)"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fullPath", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"exportDirectory", ",", 
           RowBox[{"fileName", "<>", "\"\<.pdf\>\""}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{"fullPath", ",", "finalPlot", ",", "\"\<PDF\>\""}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Peak Found at: \>\"", ",", "Bold"}], "]"}], ",", 
         "peakFreq", ",", "\"\< Hz\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       "finalPlot"}]}], "]"}]}]}]}]], "Input",
