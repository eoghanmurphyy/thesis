Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "general", " ", "formula", " ", "for", " ", "the", " ", "magnitude", " ", 
     "of", " ", "the", " ", "velocity"}], ",", " ", 
    RowBox[{
    "for", " ", "a", " ", "general", " ", "spherically", " ", "symmetric", " ",
      "Isotropic", " ", "metric"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"umagVel", "[", 
     RowBox[{"ur_", ",", " ", "uphi_", ",", " ", "rbar_"}], "]"}], " ", ":=", 
    " ", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["ur", "2"], " ", "+", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["uphi", "rbar"], ")"}], "2"]}]]}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"umagE", "[", 
      RowBox[{"Energy_", ",", " ", "rbar_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"A", "[", "rbar", "]"}], 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["Energy", 
           RowBox[{"\[Alpha]", "[", "rbar", "]"}]], ")"}], "2"], " ", "-", 
        " ", "1"}]]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"eq", " ", "48", " ", "in", " ", "paper"}], "*)"}]}]}]], "Input",
