Cell[BoxData[
 RowBox[{
  RowBox[{"hData", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"hplus", "[", "t", "]"}], " ", "-", " ", 
      RowBox[{"I", "*", 
       RowBox[{"hcross", "[", "t", "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "tFinish", ",", " ", "0.1"}], 
      "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.985180940848249*^9, {3.985181018831727*^9, 3.985181070511293*^9}, 
   3.985181692658996*^9, {3.985182625563921*^9, 
   3.985182627220282*^9}},ExpressionUUID->"80945e2c-419a-44a4-80b3-\
a8690f8b59ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Ensure", " ", "your", " ", "time", " ", "step", " ", "dt", " ", "is", " ",
     "defined", " ", "based", " ", "on", " ", "your", " ", "data", " ", 
    "generation"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"dt", "=", "0.1"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Example", " ", "value"}], ";", 
     RowBox[{
     "replace", " ", "with", " ", "your", " ", "actual", " ", "time", " ", 
      "step"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"fs", "=", 
     RowBox[{"1", "/", "dt"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Sampling", " ", "frequency"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{"Length", "[", "hData", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.985180730339933*^9, 3.9851807303399487`*^9}, {
  3.985182629372128*^9, 
  3.985182629524274*^9}},ExpressionUUID->"c10c99f7-8de4-43d2-bf9f-\
e30fd3733876"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Compute", " ", "the", " ", "DFT"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ftData", "=", 
     RowBox[{"Fourier", "[", 
      RowBox[{"hData", ",", 
       RowBox[{"FourierParameters", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "corresponding", " ", "frequency", " ", 
     "bins"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Only", " ", "the", " ", "first", " ", "half", " ", "of", " ", "the", " ",
      "data", " ", "is", " ", "needed", " ", "for", " ", "physical", " ", 
     "frequencies", " ", 
     RowBox[{"(", "Nyquist", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"frequencies", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", "-", "1"}], ")"}], "*", 
        RowBox[{"fs", "/", 
         RowBox[{"(", 
          RowBox[{"n", "*", "7", " ", 
           SuperscriptBox["10", 
            RowBox[{"-", "6"}]]}], ")"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{
          RowBox[{"Floor", "[", 
           RowBox[{"n", "/", "2"}], "]"}], "+", "1"}]}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"powerSpectrum", "=", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"ftData", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "frequencies", "]"}]}], "]"}], "]"}], "]"}], 
      "^", "2"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.985180737299685*^9, 3.9851807372997026`*^9}, {
   3.9851808077136374`*^9, 3.985180810850202*^9}, 3.985182623588614*^9, 
   3.985183703021797*^9},ExpressionUUID->"f665b4d8-b5d5-42fe-9017-\
dc7fd55b1f8e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Find", " ", "the", " ", "index", " ", "of", " ", "the", " ", "peak"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"peakIndex", "=", 
     RowBox[{"First", "[", 
      RowBox[{"Ordering", "[", 
       RowBox[{"powerSpectrum", ",", 
        RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Extract", " ", "the", " ", "actual", " ", "frequency", " ", "value"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"prominentFrequency", "=", 
     RowBox[{"frequencies", "[", 
      RowBox[{"[", "peakIndex", "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<The most prominent GW frequency is: \>\"", ",", 
      "prominentFrequency"}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.985180748715535*^9, 3.9851807487155523`*^9}},
 CellLabel->
  "In[426]:=",ExpressionUUID->"e3bddf6e-9e65-4777-a50a-46aa6d4854a3"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"The most prominent GW frequency is: \"\>", "\[InvisibleSpace]",
    "0.0015408320493066256`"}],
  SequenceForm["The most prominent GW frequency is: ", 0.0015408320493066256`],
  Editable->False]], "Print",
