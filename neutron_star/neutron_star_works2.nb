Cell[BoxData[
 RowBox[{
  RowBox[{"anaylticline", "[", "Mach_", "]"}], " ", ":=", " ", 
  RowBox[{"y1", " ", "+", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"y2", " ", "-", " ", "y1"}], ")"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Mach", " ", "-", " ", "x1"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"x2", " ", "-", " ", "x1"}], ")"}]}]}]}]}]], "Input",
