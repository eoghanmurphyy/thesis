Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fMachLow", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"1", "+", " ", "m"}], 
       RowBox[{"1", " ", "-", " ", "m"}]], "]"}]}], " ", "-", " ", "m"}]}], 
  " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fMachhigh", "[", "m_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox["1", 
       SuperscriptBox["m", "2"]]}], "]"}]}], "  ", "+", " ", 
   "10"}]}]}], "Input",
 CellChangeTimes->{{3.982656752103551*^9, 3.9826567847752333`*^9}, {
  3.9826568157830973`*^9, 3.9826568619268703`*^9}, {3.982657513737458*^9, 
  3.982657552049438*^9}},
 CellLabel->
  "In[141]:=",ExpressionUUID->"2353109e-f3f5-4a59-9c71-0468467f181f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x1", "=", ".9999"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x2", "=", "1.0001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y1", "=", 
   RowBox[{"fMachLow", "[", "x1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y2", "=", 
   RowBox[{"fMachhigh", "[", "x2", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.982657469610718*^9, 3.98265749962558*^9}, {
  3.982657559465547*^9, 3.982657580945087*^9}, {3.98265779162302*^9, 
  3.982657797814961*^9}, {3.9826579931499147`*^9, 3.982657995149737*^9}, {
  3.9826580830449057`*^9, 3.9826580849168777`*^9}, {3.9847266488192387`*^9, 
  3.984726652437675*^9}},
 CellLabel->
  "In[143]:=",ExpressionUUID->"f72d6146-bf91-466d-9faa-0371e31cd107"],

Cell[BoxData[
 RowBox[{
  RowBox[{"anaylticline", "[", "Mach_", "]"}], " ", ":=", " ", 
  RowBox[{"y1", " ", "+", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"y2", " ", "-", " ", "y1"}], ")"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Mach", " ", "-", " ", "x1"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"x2", " ", "-", " ", "x1"}], ")"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.982657915230756*^9, 3.982657921589922*^9}},
 CellLabel->
  "In[147]:=",ExpressionUUID->"fb9a2c35-9609-418f-b1a6-0297a54296fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"IVariableInterpolated", "[", "\[CapitalMu]ach_", "]"}], " ", ":=",
    " ", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"Log", "[", 
           FractionBox[
            RowBox[{"1", "+", " ", "\[CapitalMu]ach"}], 
            RowBox[{"1", " ", "-", " ", "\[CapitalMu]ach"}]], "]"}]}], " ", "-",
          " ", "\[CapitalMu]ach"}], ",", " ", 
        RowBox[{"\[CapitalMu]ach", " ", "<", " ", "x1"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"anaylticline", "[", "\[CapitalMu]ach", "]"}], ",", " ", 
        RowBox[{
        "x1", " ", "<=", " ", "\[CapitalMu]ach", "  ", "<", " ", "x2"}]}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"Log", "[", 
           RowBox[{"1", " ", "-", " ", 
            FractionBox["1", 
             SuperscriptBox["\[CapitalMu]ach", "2"]]}], "]"}]}], "  ", "+", 
         " ", "10"}], ",", " ", 
        RowBox[{"\[CapitalMu]ach", " ", ">=", " ", "x2"}]}], "}"}]}], 
     "\[IndentingNewLine]", "}"}], "]"}]}], ";"}]], "Input",
