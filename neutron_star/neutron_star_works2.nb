Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Convert", " ", "lists", " ", "to", " ", "interpolation", " ", 
    "functions"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Note", ":", 
    RowBox[{
    "This", " ", "assumes", " ", "your", " ", "data", " ", "is", " ", "in", " ",
      "the", " ", "format", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x1", ",", "y1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x2", ",", "y2"}], "}"}], ",", "..."}], "}"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"funcData", "=", 
     RowBox[{"Interpolation", "[", "data", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"funcDataET", "=", 
     RowBox[{"Interpolation", "[", "dataET", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Determine", " ", "the", " ", "shared", " ", "range", " ", 
     "of", " ", "your", " ", "data"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tMin", ",", "tMax"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"dataET", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{"dataET", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], "]"}]}], "}"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"ThesisStandardLogLogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"funcData", "[", "t", "]"}], ",", 
       RowBox[{"funcDataET", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tMin", ",", "tMax"}], "}"}], 
     ",", "\"\<MyGWPlot_Comparison\>\"", ",", "\"\<h_c(f)\>\"", 
     ",", "\"\<f [Hz]\>\"", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\\large{\\\\textbf{LIGO}}\>\"", 
       ",", "\"\<\\\\large{\\\\textbf{ET}}\>\""}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9852481712816668`*^9, 3.985248232344105*^9}, {
