Cell[TextData[Cell[BoxData[
 FormBox[
  SubscriptBox["h", "+"], 
  TraditionalForm]],ExpressionUUID->"94cd0dc2-dfe9-43c9-8694-634a16a39eaa"]], \
"Subsection",
 CellChangeTimes->{{3.982910459505817*^9, 
  3.9829104653384323`*^9}},ExpressionUUID->"3b1f387d-907f-4b64-8e2c-\
9bb9df3ed845"],

Cell[BoxData[
 RowBox[{
  RowBox[{"hplusInside", "[", 
   RowBox[{
   "d_", ",", " ", "m_", ",", " ", "rbar_", ",", " ", "ur_", ",", " ", 
    "uphi_", ",", " ", "phi_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
