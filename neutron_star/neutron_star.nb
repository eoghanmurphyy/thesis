Cell[CellGroupData[{

Cell["Setting up 2D ODEs for new density profile:", "Section",
 CellChangeTimes->{{3.9795574662013397`*^9, 3.979557480881427*^9}, {
  3.982143351540092*^9, 
  3.982143363854011*^9}},ExpressionUUID->"60532d69-0bc8-452c-b8d3-\
687df1374ea6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Isorho", "[", "rbar_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", " ", "=", " ", 
      RowBox[{"rofrbarInside", "[", "rbar", "]"}]}], "}"}], ",", " ", 
    RowBox[{"rho0", 
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"alphaaa", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["r", "RStar"], ")"}], "2"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"alphaaa", "-", "1"}], ")"}], 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["r", "RStar"], ")"}], "4"]}]}], ")"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.982990805016938*^9, 3.98299080555303*^9}},
