Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Ut", "[", 
    RowBox[{"rbar_", ",", " ", "ur_", ",", " ", "uphi_"}], "]"}], " ", ":=", 
   " ", 
   FractionBox[
    SqrtBox[
     RowBox[{"1", " ", "+", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["ur", 
         RowBox[{"A", "[", "rbar", "]"}]], ")"}], "2"], " ", "+", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["uphi", 
         RowBox[{"rbar", " ", 
          RowBox[{"A", "[", "rbar", "]"}]}]], ")"}], "2"]}]], 
    RowBox[{"\[Alpha]", "[", "rbar", "]"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"umagOutside", "[", 
   RowBox[{"rbar_", ",", " ", "ur_", ",", " ", "uphi_"}], "]"}], ":=", 
  FractionBox[
   SqrtBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["ur", "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["uphi", "rbar"], ")"}], "2"]}], ")"}]], 
   RowBox[{"A", "[", "rbar", "]"}]]}]}], "Input",
 CellChangeTimes->{{3.9823897092698803`*^9, 3.982389710710528*^9}, 
