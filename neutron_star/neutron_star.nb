    RowBox[{"mass", " ", "/.", " ", "solIn"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"tFinish", " ", "=", " ", 
  RowBox[{
   RowBox[{"rbarNumIn", "[", "\"\<Domain\>\"", "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tSurface", "=", 
   RowBox[{"t", "/.", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"rbarNumIn", "[", "t", "]"}], "==", "rbarStar"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "10", ",", "10", ",", "tFinish"}], "}"}]}], 
     "]"}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"rbarNumIn", "[", "t", "]"}], " ", 
    RowBox[{"Cos", "[", 
