  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"rbarNumIn", "[", "t", "]"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"phiNumIn", "[", "t", "]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"rbarNumIn", "[", "t", "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"phiNumIn", "[", "t", "]"}], "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
