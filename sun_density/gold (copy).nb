Cell[BoxData[
 RowBox[{
  RowBox[{"hData", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"hplus", "[", "t", "]"}], " ", "-", " ", 
      RowBox[{"I", "*", 
       RowBox[{"hcross", "[", "t", "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", 
       RowBox[{"9.5", " ", 
        SuperscriptBox["10", "8"]}], ",", " ", 
       SuperscriptBox["10", "9"], ",", " ", "1000"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{
  3.985180940848249*^9, {3.985181018831727*^9, 3.985181070511293*^9}, {
   3.985182182263689*^9, 3.985182183887426*^9}, {3.985182229359412*^9, 
   3.985182245743064*^9}, {3.9851827158357067`*^9, 3.9851827635150414`*^9}, {
   3.985182900777828*^9, 3.9851829088018923`*^9}, {3.985183154815877*^9, 
   3.985183171151842*^9}, {3.985183423853818*^9, 3.9851834339496326`*^9}},
 CellLabel->
  "In[163]:=",ExpressionUUID->"07417e3c-e2a4-4a62-b552-7a2298310b1c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Ensure", " ", "your", " ", "time", " ", "step", " ", "dt", " ", "is", " ",
     "defined", " ", "based", " ", "on", " ", "your", " ", "data", " ", 
    "generation"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"dt", "=", "1000"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Example", " ", "value"}], ";", 
     RowBox[{
     "replace", " ", "with", " ", "your", " ", "actual", " ", "time", " ", 
      "step"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"fs", "=", 
     RowBox[{"1", "/", "dt"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Sampling", " ", "frequency"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{"Length", "[", "hData", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.985180730339933*^9, 3.9851807303399487`*^9}, {
  3.9851820713043222`*^9, 3.985182072136056*^9}, {3.9851821027119637`*^9, 
  3.985182104160172*^9}, {3.98518218588763*^9, 3.98518218619163*^9}, {
  3.985182233239079*^9, 3.985182246678986*^9}, {3.985183443757855*^9, 
  3.985183444509329*^9}},
 CellLabel->
  "In[164]:=",ExpressionUUID->"e11ed14d-b4ec-4e21-a6e5-34f58d686293"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Compute", " ", "the", " ", "DFT"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ftData", "=", 
     RowBox[{"Fourier", "[", 
      RowBox[{"hData", ",", 
       RowBox[{"FourierParameters", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "corresponding", " ", "frequency", " ", 
     "bins"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Only", " ", "the", " ", "first", " ", "half", " ", "of", " ", "the", " ",
      "data", " ", "is", " ", "needed", " ", "for", " ", "physical", " ", 
     "frequencies", " ", 
     RowBox[{"(", "Nyquist", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"frequencies", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", "-", "1"}], ")"}], "*", 
        RowBox[{"fs", "/", 
         RowBox[{"(", 
          RowBox[{"n", "*", "7", " ", 
           SuperscriptBox["10", 
            RowBox[{"-", "6"}]]}], ")"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{
          RowBox[{"Floor", "[", 
           RowBox[{"n", "/", "2"}], "]"}], "+", "1"}]}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"powerSpectrum", "=", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"ftData", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "frequencies", "]"}]}], "]"}], "]"}], "]"}], 
      "^", "2"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.985180737299685*^9, 3.9851807372997026`*^9}, {
   3.9851808077136374`*^9, 3.985180810850202*^9}, 3.985181420221504*^9, {
   3.985183472005625*^9, 3.985183480661381*^9}},
 CellLabel->
  "In[167]:=",ExpressionUUID->"4ee27f1a-fdf7-4c98-8481-e159c4ec7d78"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Find", " ", "the", " ", "index", " ", "of", " ", "the", " ", "peak"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"peakIndex", "=", 
     RowBox[{"First", "[", 
      RowBox[{"Ordering", "[", 
       RowBox[{"powerSpectrum", ",", 
        RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Extract", " ", "the", " ", "actual", " ", "frequency", " ", "value"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"prominentFrequency", "=", 
     RowBox[{"frequencies", "[", 
      RowBox[{"[", "peakIndex", "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<The most prominent GW frequency is: \>\"", ",", 
      "prominentFrequency"}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.985180748715535*^9, 3.9851807487155523`*^9}},
 CellLabel->
  "In[170]:=",ExpressionUUID->"717f270a-4a19-447a-a836-ce0f15107816"],

