Cell[CellGroupData[{

Cell[TextData[{
 "Energy loss during orbits ",
 StyleBox["CHECK angles and other assumptions made by authors for these \
formulae especially the angular momentum stuff.",
  FontWeight->"Bold",
  FontColor->RGBColor[1., 0., 0.]]
}], "Section",
 CellChangeTimes->{{3.9829080587145233`*^9, 3.982908071585734*^9}, {
  3.982908598693872*^9, 3.9829086053179703`*^9}, {3.982909235016552*^9, 
