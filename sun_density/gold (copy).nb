  RowBox[{"anaylticline", "[", "Mach_", "]"}], " ", ":=", " ", 
  RowBox[{"y1", " ", "+", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"y2", " ", "-", " ", "y1"}], ")"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Mach", " ", "-", " ", "x1"}], ")"}], "/", 
