Cell[BoxData[
 RowBox[{
  RowBox[{"dPhidrMetric", "[", "r_", "]"}], " ", ":=", " ", 
  RowBox[{"(", 
   FractionBox[
    RowBox[{
     RowBox[{"MassFunc", "[", "r", "]"}], " ", "+", " ", 
     RowBox[{"4", " ", "Pi", " ", 
      RowBox[{"Pressure", "[", "r", "]"}], " ", 
      SuperscriptBox["r", "3"]}]}], 
    RowBox[{"r", 
     RowBox[{"(", 
      RowBox[{"r", "-", 
       RowBox[{"2", 
        RowBox[{"MassFunc", "[", "r", "]"}]}]}], ")"}]}]], ")"}]}]], "Input",
