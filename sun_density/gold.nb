Cell[BoxData[
 RowBox[{"ThesisStandardPlot", "[", 
  RowBox[{
   RowBox[{"asosPiecewise", "[", 
    RowBox[{"x", "*", "rbarStar"}], "]"}], ",", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "The", " ", "function", " ", 
     RowBox[{"(", 
      RowBox[{"scaled", " ", "back", " ", "to", " ", "rbar"}], ")"}]}], 
    "*)"}], 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "2.", " ", "Plotting", " ", "from", " ", "0", " ", "to", " ", "1", " ", 
      "on", " ", "the", " ", "x"}], "-", "axis"}], "*)"}], "\"\<Fig_asos\>\"",
    ",", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Filename"}], "*)"}], "\"\<a(\\\\bar{r})\>\"", ",", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"4.", " ", "y"}], "-", "label"}], 
    "*)"}], "\"\<\\\\bar{r}/\\\\bar{R}^*\>\"", ",", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"5.", " ", "x"}], "-", 
     RowBox[{"label", " ", 
      RowBox[{"(", 
       RowBox[{"The", " ", "scaled", " ", "label"}], ")"}]}]}], "*)"}], 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"(*", 
    RowBox[{"6.", " ", "No", " ", "legends"}], "*)"}], "None", ",", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"7.", " ", "No", " ", "specific", " ", "x"}], "-", "tick"}], 
    "*)"}], "200", ",", 
