Cell["Setting up 2D ODEs for new density profile:", "Section",
 CellChangeTimes->{{3.9795574662013397`*^9, 3.979557480881427*^9}, {
  3.982143351540092*^9, 
  3.982143363854011*^9}},ExpressionUUID->"60532d69-0bc8-452c-b8d3-\
687df1374ea6"],

Cell[CellGroupData[{

Cell["Mach number interpolation", "Subsection",
 CellChangeTimes->{{3.979557365442395*^9, 3.979557369138154*^9}, {
  3.979557484441403*^9, 3.9795574953773937`*^9}, {3.982143441963381*^9, 
  3.98214344582716*^9}},ExpressionUUID->"dd0e3d6f-c58b-4da2-98d3-\
52ef78ee100c"],

Cell[CellGroupData[{

Cell["Interpolating", "Subsubsection",
 CellChangeTimes->{{3.9806809431072083`*^9, 
  3.98068094516302*^9}},ExpressionUUID->"93b9c1b9-8772-4b3b-8c6c-\
4399e026b006"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fMachLow", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"1", "+", " ", "m"}], 
       RowBox[{"1", " ", "-", " ", "m"}]], "]"}]}], " ", "-", " ", "m"}]}], 
  " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fMachhigh", "[", "m_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox["1", 
       SuperscriptBox["m", "2"]]}], "]"}]}], "  ", "+", " ", 
   "10"}]}]}], "Input",
 CellChangeTimes->{{3.982656752103551*^9, 3.9826567847752333`*^9}, {
