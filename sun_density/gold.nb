           RowBox[{"rd", " ", 
            RowBox[{"Cos", "[", "phi", "]"}]}], " ", "-", " ", 
           RowBox[{"r", " ", "phid", " ", 
            RowBox[{"Sin", "[", "phi", "]"}]}]}], ")"}]}]}], ")"}]}]}]}], 
