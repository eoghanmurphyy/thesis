Cell[BoxData[
 RowBox[{
  RowBox[{"asosPiecewise", "[", 
   RowBox[{"rbar_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", "=", 
      RowBox[{"rofrbarInside", "[", "rbar", "]"}]}], "}"}], ",", 
    RowBox[{"Piecewise", "[", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"dPdr", "[", 
            RowBox[{"r", ",", 
             RowBox[{"Pressure", "[", "r", "]"}]}], "]"}], "/", 
           RowBox[{"drhodr", "[", "r", "]"}]}], "]"}], ",", 
         RowBox[{"rbar", "<", "cutoffIso"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"asosEnd", "[", "rbar", "]"}], ",", 
         RowBox[{"cutoffIso", "<=", "rbar", "<=", "rbarStar"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"asosEnd", "[", "rbarStar", "]"}], ",", " ", 
         RowBox[{"rbar", " ", ">", " ", "rbarStar"}]}], "}"}]}], 
      "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.983712634561122*^9, 3.983712636586297*^9}, 
   3.983713179411436*^9, {3.983713643504496*^9, 3.983713643619235*^9}, {
   3.983772536489963*^9, 3.98377254719381*^9}},
 CellLabel->"In[86]:=",ExpressionUUID->"82e97cfe-ef06-44d3-8cb8-09e585d7a5a0"],

