        RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], ",", " ", 
       RowBox[{"rbar", " ", ">=", " ", "rbarStar"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"umagInside", "[", 
        RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], ",", " ", 
       RowBox[{"rbar", " ", "<", " ", "rbarStar"}]}], "}"}]}], 
