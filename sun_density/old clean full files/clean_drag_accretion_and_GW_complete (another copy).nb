 RowBox[{
  RowBox[{"x2", "=", "1.02"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y1", "=", 
   RowBox[{"fMachLow", "[", "x1", "]"}]}], ";"}], "\[IndentingNewLine]", 
