Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"duphidtInside", "[", 
     RowBox[{
      RowBox[{"m_", "?", "NumericQ"}], ",", " ", 
      RowBox[{"rbar_", "?", "NumericQ"}], ",", " ", 
      RowBox[{"ur_", "?", "NumericQ"}], ",", " ", 
      RowBox[{"uphi_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
    RowBox[{
     FractionBox["\[Eta]", "m"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"dpdtaccretionphi", "[", 
        RowBox[{"m", ",", " ", "rbar", ",", " ", "ur", ",", " ", "uphi"}], 
        "]"}], " ", "+", " ", 
       RowBox[{"dpdtdragphi", "[", 
        RowBox[{"m", ",", " ", "rbar", ",", " ", "ur", ",", " ", "uphi"}], 
        "]"}], " ", "+", " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"AInside", "[", "rbar", "]"}], "2"], " ", 
        SuperscriptBox["rbar", "2"], " ", 
        RowBox[{"FRRphiIns", "[", 
         RowBox[{"m", ",", " ", "rbar", ",", " ", "ur", ",", " ", "uphi"}], 
         "]"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"durdt2DInside", "[", 
    RowBox[{
     RowBox[{"m_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"rbar_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"ur_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"uphi_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"\[Alpha]Inside", "[", "rbar", "]"}]}], " ", 
