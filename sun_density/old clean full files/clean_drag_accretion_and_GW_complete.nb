Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Ut", "[", 
    RowBox[{
     RowBox[{"rbar_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"ur_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"uphi_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   FractionBox[
    SqrtBox[
     RowBox[{"1", " ", "+", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["ur", 
         RowBox[{"A", "[", "rbar", "]"}]], ")"}], "2"], " ", "+", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["uphi", 
         RowBox[{"rbar", " ", 
