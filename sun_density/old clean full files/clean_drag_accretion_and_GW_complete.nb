    RowBox[{"ur_", "?", "NumericQ"}], ",", " ", 
    RowBox[{"uphi_", "?", "NumericQ"}]}], "]"}], ":=", 
  FractionBox[
   SqrtBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["ur", "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["uphi", "rbar"], ")"}], "2"]}], ")"}]], 
