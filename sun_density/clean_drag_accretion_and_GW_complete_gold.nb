Cell[BoxData[{
 RowBox[{
  RowBox[{"rbarNumIn", " ", "=", " ", 
   RowBox[{"rbar", " ", "/.", " ", "solIn"}]}], 
  ";"}], "\[IndentingNewLine]", 
