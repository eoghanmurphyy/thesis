Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Ensure", " ", "data", " ", "is", " ", 
    RowBox[{"numeric", "/", "floating"}], " ", "point"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"hData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"hplus", "[", "t", "]"}], "-", 
         RowBox[{"I", "*", 
          RowBox[{"hcross", "[", "t", "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tFinish", ",", "dt"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Standard", " ", "DFT"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"hFrequencyData", "=", 
     RowBox[{"Fourier", "[", 
      RowBox[{"hData", ",", 
       RowBox[{"FourierParameters", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hFreqNorm", "=", 
     RowBox[{"Abs", "[", "hFrequencyData", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{"Length", "[", "hData", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Standard", " ", "Frequency", " ", "Axis", " ", 
     RowBox[{"(", "Hz", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Remove", " ", "the", " ", "7", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "5"}]}], " ", "until", " ", "you", " ", "confirm", " ", 
     "the", " ", "peaks", " ", 
     RowBox[{"exist", "!"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"freqs", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", "-", "1"}], ")"}], "*", 
        RowBox[{"fs", "/", "n"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"4.", " ", "Combine", " ", "and", " ", "Plot"}], "-", 
     RowBox[{"focusing", " ", "on", " ", "the", " ", "first", " ", "half", " ", 
      RowBox[{"(", "Nyquist", ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"dftTable", "=", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"freqs", ",", "hFreqNorm"}], "}"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", 
        RowBox[{"Floor", "[", 
         RowBox[{"n", "/", "2"}], "]"}]}], "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{"dftTable", ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Frequency (Hz)\>\"", ",", "\"\<Strain Amplitude\>\""}], 
       "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", "Blue"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.985177663203486*^9, 3.985177663203504*^9}, 
   3.985177820277614*^9},
