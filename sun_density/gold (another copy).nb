       RowBox[{"drBardt", "[", 
        RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"8", " ", 
          RowBox[{"M", "^", "2"}]}], "+", 
         RowBox[{"r", " ", "M", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"6", " ", 
             RowBox[{
              RowBox[{"drBardt", "[", 
               RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], "^",
