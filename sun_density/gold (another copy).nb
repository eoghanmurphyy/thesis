Cell[CellGroupData[{

Cell["Setting up 2D ODEs for new density profile:", "Section",
 CellChangeTimes->{{3.9795574662013397`*^9, 3.979557480881427*^9}, {
  3.982143351540092*^9, 
  3.982143363854011*^9}},ExpressionUUID->"60532d69-0bc8-452c-b8d3-\
687df1374ea6"],

Cell[CellGroupData[{

Cell["Mach number interpolation", "Subsection",
 CellChangeTimes->{{3.979557365442395*^9, 3.979557369138154*^9}, {
  3.979557484441403*^9, 3.9795574953773937`*^9}, {3.982143441963381*^9, 
  3.98214344582716*^9}},ExpressionUUID->"dd0e3d6f-c58b-4da2-98d3-\
52ef78ee100c"],

Cell[CellGroupData[{

Cell["Interpolating", "Subsubsection",
 CellChangeTimes->{{3.9806809431072083`*^9, 
  3.98068094516302*^9}},ExpressionUUID->"93b9c1b9-8772-4b3b-8c6c-\
4399e026b006"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fMachLow", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"1", "+", " ", "m"}], 
       RowBox[{"1", " ", "-", " ", "m"}]], "]"}]}], " ", "-", " ", "m"}]}], 
  " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fMachhigh", "[", "m_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox["1", 
       SuperscriptBox["m", "2"]]}], "]"}]}], "  ", "+", " ", 
   "10"}]}]}], "Input",
 CellChangeTimes->{{3.982656752103551*^9, 3.9826567847752333`*^9}, {
  3.9826568157830973`*^9, 3.9826568619268703`*^9}, {3.982657513737458*^9, 
  3.982657552049438*^9}},
 CellLabel->
  "In[108]:=",ExpressionUUID->"2353109e-f3f5-4a59-9c71-0468467f181f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x1", "=", ".9999"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x2", "=", "1.0001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y1", "=", 
   RowBox[{"fMachLow", "[", "x1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y2", "=", 
   RowBox[{"fMachhigh", "[", "x2", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.982657469610718*^9, 3.98265749962558*^9}, {
  3.982657559465547*^9, 3.982657580945087*^9}, {3.98265779162302*^9, 
  3.982657797814961*^9}, {3.9826579931499147`*^9, 3.982657995149737*^9}, {
  3.9826580830449057`*^9, 3.9826580849168777`*^9}, {3.9837117928808193`*^9, 
  3.983711794999408*^9}, {3.983713302007865*^9, 3.983713303673813*^9}, {
  3.984656824717267*^9, 3.984656830857437*^9}},
 CellLabel->
  "In[110]:=",ExpressionUUID->"f72d6146-bf91-466d-9faa-0371e31cd107"],

Cell[BoxData[
 RowBox[{
  RowBox[{"anaylticline", "[", "Mach_", "]"}], " ", ":=", " ", 
  RowBox[{"y1", " ", "+", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"y2", " ", "-", " ", "y1"}], ")"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Mach", " ", "-", " ", "x1"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"x2", " ", "-", " ", "x1"}], ")"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.982657915230756*^9, 3.982657921589922*^9}},
 CellLabel->
  "In[114]:=",ExpressionUUID->"fb9a2c35-9609-418f-b1a6-0297a54296fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"IVariableInterpolated", "[", "\[CapitalMu]ach_", "]"}], " ", ":=",
    " ", 
   RowBox[{"Piecewise", "[", 
