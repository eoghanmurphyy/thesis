         RowBox[{"1", "-", 
          RowBox[{"2", 
           FractionBox["M", "RStar"]}]}]]}]]]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "is", " ", "the", " ", "constant", " ", "to", " ", "match", " ",
