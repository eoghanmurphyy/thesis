 CellChangeTimes->{{3.9806809431072083`*^9, 
  3.98068094516302*^9}},ExpressionUUID->"5e42f93e-5710-48d4-8afe-\
76ba6a824d22"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fMachLow", "[", "m_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"1", "+", " ", "m"}], 
       RowBox[{"1", " ", "-", " ", "m"}]], "]"}]}], " ", "-", " ", "m"}]}], 
  " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fMachhigh", "[", "m_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox["1", 
       SuperscriptBox["m", "2"]]}], "]"}]}], "  ", "+", " ", 
   "10"}]}]}], "Input",
 CellChangeTimes->{{3.982656752103551*^9, 3.9826567847752333`*^9}, {
  3.9826568157830973`*^9, 3.9826568619268703`*^9}, {3.982657513737458*^9, 
  3.982657552049438*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"f778c235-fb6f-466c-9a12-197f6ac84b80"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"x1", "=", ".9999"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x2", "=", "1.0001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y1", "=", 
   RowBox[{"fMachLow", "[", "x1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y2", "=", 
