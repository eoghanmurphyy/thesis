              RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], "^", 
             "2"}]}], "-", 
           RowBox[{"2", " ", 
            RowBox[{"Mp", "[", "r", "]"}]}]}], ")"}]}], "-", 
        RowBox[{
         RowBox[{"r", "^", "2"}], " ", 
         RowBox[{
          RowBox[{"drBardtInside", "[", 
           RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], "^", 
