        RowBox[{"anaylticline", "[", "Mach", "]"}], ",", " ", 
        RowBox[{"0.9999", " ", "<", " ", "Mach", "  ", "<", " ", "1.0001"}]}],
        "}"}], ",", "\[IndentingNewLine]", 
