      RowBox[{"dphidtInside", "[", 
       RowBox[{"rbar", ",", "ur", ",", "uphi"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       FractionBox[
        RowBox[{
         RowBox[{"-", "2"}], "m"}], "d"], ")"}], 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"Mfunc", "[", "r", "]"}], " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"2", " ", "phi"}], "]"}]}], "r"], " ", "-", " ", 
        RowBox[{
         SuperscriptBox["rd", "2"], " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", "phi"}], "]"}]}], " ", "+", " ", 
        RowBox[{"2", "rd", " ", "r", " ", "phid", " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"2", "phi"}], "]"}]}], " ", "+", " ", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"r", " ", "phid"}], ")"}], "2"], 
         RowBox[{"Cos", "[", 
          RowBox[{"2", "phi"}], "]"}]}]}], ")"}]}]}]}], "\[IndentingNewLine]",
    "]"}]}]], "Input",
