 RowBox[{
  RowBox[{"anaylticline", "[", "Mach_", "]"}], " ", ":=", " ", 
  RowBox[{"y1", " ", "+", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"y2", " ", "-", " ", "y1"}], ")"}], " ", 
