  3.982908917635139*^9}},ExpressionUUID->"88e2c804-5297-41d7-92c5-\
4b1472a809ca"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "Formula", " ", "might", " ", "need", " ", "to", " ", "be", " ", 
    "adjusted", " ", "for", " ", "me", " ", "as", " ", "they", " ", "use", " ",
     "the", " ", "angle", " ", "phi"}], " ", "=", " ", 
   RowBox[{
   "0", " ", "for", " ", "when", " ", "it", " ", "crosses", " ", "the", " ", 
    "star", " ", "surface", " ", "which", " ", "is", " ", "not", " ", "true", 
    " ", "for", " ", "me"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.9829091670181303`*^9, 3.982909195169149*^9}},
 CellLabel->
  "In[267]:=",ExpressionUUID->"d37d42e4-2f23-44a3-999c-4696ff08ff06"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dLdtAvg", "[", 
   RowBox[{"m_", ",", "M_", ",", "a_", ",", "e_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"32", " ", 
       RowBox[{"m", "^", "2"}], " ", 
       RowBox[{"M", "^", 
        RowBox[{"(", 
         RowBox[{"5", "/", "2"}], ")"}]}]}], ")"}]}], "/", 
    RowBox[{"(", 
     RowBox[{"5", " ", 
      RowBox[{"a", "^", 
       RowBox[{"(", 
        RowBox[{"7", "/", "2"}], ")"}]}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"e", "^", "2"}]}], ")"}], "^", 
       RowBox[{"(", "2", ")"}]}]}], ")"}]}], "*", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"7", "/", "8"}], ")"}], " ", 
      RowBox[{"e", "^", "2"}]}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.982908695319152*^9, 3.982908695319168*^9}, {
  3.982908921003359*^9, 3.98290892892343*^9}, {3.982909074962366*^9, 
