   OverscriptBox["r", "_"], TraditionalForm]],ExpressionUUID->
  "c2018a4f-40e9-4815-b3bf-9e84da3c4147"],
 "(r) for the interior"
}], "Subsection",
 CellChangeTimes->{{3.9806789303493757`*^9, 3.980678935965378*^9}, {
  3.980679131228282*^9, 3.980679156483783*^9}, {3.982815175631024*^9, 
  3.9828151881274242`*^9}},ExpressionUUID->"d70d6f46-1ad1-4b61-a533-\
157307a4a03e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Kappa]", " ", "=", " ", 
    SqrtBox[
     RowBox[{"2", 
      FractionBox["M", 
       SuperscriptBox["RStar", "3"]]}]]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Integral", " ", "constant", " ", "I", " ", "used", " ", "by", " ", 
    "hand"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Const", " ", "=", " ", 
    RowBox[{
     RowBox[{"rbarofrOutside", "[", "RStar", "]"}], 
     SqrtBox[
      FractionBox[
       RowBox[{"1", "+", 
        SqrtBox[
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"2", "M"}], "RStar"]}]]}], 
       RowBox[{"1", "-", 
        SqrtBox[
         RowBox[{"1", "-", 
          RowBox[{"2", 
           FractionBox["M", "RStar"]}]}]]}]]]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "is", " ", "the", " ", "constant", " ", "to", " ", "match", " ",
     "up", " ", "the", " ", "metrics"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.98281520283165*^9, 3.982815203247488*^9}},
 CellLabel->
  "In[788]:=",ExpressionUUID->"0a772a07-9e78-4f40-bcb9-38bfdd26fef2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rbarofrInside", "[", "r_", "]"}], ":=", 
   RowBox[{"Const", " ", 
    SqrtBox[
     FractionBox[
      RowBox[{"1", "-", 
       SqrtBox[
        RowBox[{"1", "-", 
         RowBox[{"2", 
          FractionBox[
           RowBox[{"Mfunc", "[", "r", "]"}], "r"]}]}]]}], 
      RowBox[{"1", "+", 
       SqrtBox[
        RowBox[{"1", "-", 
         RowBox[{"2", 
          FractionBox[
           RowBox[{"Mfunc", "[", "r", "]"}], "r"]}]}]]}]]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rofrbarInside", "[", "rbar_", "]"}], ":=", 
   RowBox[{
    FractionBox["1", "\[Kappa]"], 
    SqrtBox[
     RowBox[{"1", "-", 
      SuperscriptBox[
       RowBox[{"Tanh", "[", 
        RowBox[{"Log", "[", 
         FractionBox["rbar", "Const"], "]"}], "]"}], "2"]}]]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.982814726454424*^9, 3.98281473592638*^9}},
 CellLabel->
  "In[790]:=",ExpressionUUID->"3f4512f3-fa42-44ba-aed5-66bbc45b5f1b"]
}, Open  ]],

