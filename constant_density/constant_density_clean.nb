Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FRRphiIns", "[", 
    RowBox[{"m_", ",", " ", "rbar_", ",", "ur_", ",", " ", "uphi_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"rofrbarInside", "[", "rbar", "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"8", " ", 
         RowBox[{"m", "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"5", " ", 
         RowBox[{"r", "^", "4"}]}], ")"}]}], "*", 
      RowBox[{"dphidtInside", "[", 
       RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{
          RowBox[{"MassFunction", "[", "r", "]"}], "^", "2"}]}], "+", 
        RowBox[{"2", " ", 
         RowBox[{"r", "^", "4"}], " ", 
         RowBox[{
          RowBox[{"dphidtInside", "[", 
           RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], "^", 
          "2"}], " ", 
         RowBox[{"Mp", "[", "r", "]"}]}], "+", 
        RowBox[{"r", " ", 
         RowBox[{"MassFunction", "[", "r", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"9", " ", 
            RowBox[{
             RowBox[{"drBardtInside", "[", 
              RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], "^", 
             "2"}]}], "-", 
           RowBox[{"6", " ", 
            RowBox[{"r", "^", "2"}], " ", 
            RowBox[{
             RowBox[{"dphidtInside", "[", 
              RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], "^", 
             "2"}]}], "-", 
           RowBox[{"2", " ", 
            RowBox[{"Mp", "[", "r", "]"}]}]}], ")"}]}], "-", 
        RowBox[{
         RowBox[{"r", "^", "2"}], " ", 
         RowBox[{
          RowBox[{"drBardtInside", "[", 
           RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], "^", 
          "2"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"7", " ", 
            RowBox[{"Mp", "[", "r", "]"}]}], "-", 
           RowBox[{"2", " ", "r", " ", 
