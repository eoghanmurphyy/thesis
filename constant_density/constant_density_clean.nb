b409ad6000c1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dLdtOutside", "[", 
   RowBox[{"m_", ",", " ", "rbar_", ",", " ", "ur_", ",", " ", "uphi_"}], 
   "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", "=", 
      RowBox[{"rofrbarOutside", "[", "rbar", "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     SuperscriptBox["r", "2"], " ", 
     RowBox[{"FRRphi", "[", 
      RowBox[{"m", ",", " ", "rbar", ",", " ", "ur", ",", " ", "uphi"}], 
      "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dLdtInside", "[", 
   RowBox[{"m_", ",", " ", "rbar_", ",", " ", "ur_", ",", " ", "uphi_"}], 
   "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", "=", 
      RowBox[{"rofrbarInside", "[", "rbar", "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     SuperscriptBox["r", "2"], " ", 
     RowBox[{"FRRphiIns", "[", 
      RowBox[{"m", ",", " ", "rbar", ",", " ", "ur", ",", " ", "uphi"}], 
      "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9829080741491127`*^9, 3.982908074149129*^9}, {
