Cell["Pressure function derived analytically", "Subsection",
 CellChangeTimes->{{3.9828155114276447`*^9, 
  3.982815517146243*^9}},ExpressionUUID->"f4131cdf-ac3c-4835-886e-\
64512448951c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"P", "[", "rbar_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Rho]", 
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SqrtBox[
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"2", 
           FractionBox[
            RowBox[{"M", " ", 
             SuperscriptBox["r", "2"]}], 
            SuperscriptBox["RStar", "3"]]}]}]], "-", 
        SqrtBox[
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"2", 
           FractionBox["M", "RStar"]}]}]]}], 
       RowBox[{
        RowBox[{"3", 
         SqrtBox[
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"2", 
            FractionBox["M", "RStar"]}]}]]}], " ", "-", " ", 
        SqrtBox[
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"2", 
           FractionBox[
            RowBox[{"M", " ", 
             SuperscriptBox["r", "2"]}], 
            SuperscriptBox["RStar", "3"]]}]}]]}]], ")"}]}], " ", "/.", 
    RowBox[{"r", "->", 
     RowBox[{"rofrbarInside", "[", "rbar", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
