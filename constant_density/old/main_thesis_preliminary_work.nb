Cell["General Integration and Differentiation checks", "Text",
 CellChangeTimes->{{3.9782688098389387`*^9, 
  3.978268818781024*^9}},ExpressionUUID->"bce2c8c4-6b39-4dcc-9125-\
d2f27942fdf4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       RowBox[{"Tanh", "[", "x", "]"}], "^", "2"}]}], ",", "x"}], "]"}], 
   ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Computing", " ", "a", " ", "derivative"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.978003319293399*^9, 3.978003378410818*^9}, {
   3.978268705886215*^9, 3.9782687113978777`*^9}, 3.9795538079514513`*^9},
 CellLabel->"In[30]:=",ExpressionUUID->"bfbb4e7d-f7c6-47e5-9208-9a1c4caf7f78"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eq", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "1"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Cosh", "[", "x", "]"}], "^", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{
         RowBox[{"Tanh", "[", "x", "]"}], "^", "2"}]}], ")"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{"eq", ",", " ", "x"}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.978003669199806*^9, 3.9780036722218733`*^9}, {
  3.9780037041011333`*^9, 3.978003744586924*^9}, {3.979553812111568*^9, 
  3.979553815959977*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"20b51a5e-94c7-4fd8-b13d-0382cf9b4341"],

Cell[TextData[{
 "Final equation obtained for ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["r", "_"], TraditionalForm]],ExpressionUUID->
  "c235567b-b4cc-4f22-8668-45bc48f0f3ed"],
 ", more on r on paper in my copy."
}], "Text",
 CellChangeTimes->{{3.978004493639595*^9, 3.9780045120516787`*^9}, {
  3.978268831124888*^9, 3.9782688479646893`*^9}, {3.9795538333752823`*^9, 
  3.979553864694747*^9}},ExpressionUUID->"059b2fda-82de-4a1c-899b-\
3f649c3b7bb5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"eq", " ", "=", " ", 
  RowBox[{"rbar", " ", "==", " ", 
   RowBox[{"C", " ", "*", " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"k", "^", "2"}], " ", 
           RowBox[{"r", "^", "2"}]}]}], "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{
           RowBox[{"k", "^", "2"}], " ", 
           RowBox[{"r", "^", "2"}]}]}], "]"}]}], ")"}]}], 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.978004513351121*^9, 3.978004643198886*^9}, {
  3.9782687601899357`*^9, 3.978268764981827*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"06968500-49aa-43a8-b99f-7aedc7da43b0"],

Cell[BoxData[
 RowBox[{"rbar", "\[Equal]", 
  RowBox[{"C", " ", 
   SqrtBox[
    FractionBox[
     RowBox[{"1", "-", 
      SqrtBox[
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["k", "2"], " ", 
         SuperscriptBox["r", "2"]}]}]]}], 
     RowBox[{"1", "+", 
      SqrtBox[
       RowBox[{"1", "+", 
        RowBox[{
         SuperscriptBox["k", "2"], " ", 
         SuperscriptBox["r", "2"]}]}]]}]]]}]}]], "Output",
 CellChangeTimes->{3.984743113263073*^9, 3.984802565480019*^9, 
  3.985142952712882*^9},
 CellLabel->"Out[33]=",ExpressionUUID->"1e842700-c0c3-439b-9024-c0c4f6d47304"]
}, Open  ]]
}, Open  ]]
