Cell[CellGroupData[{

Cell["\<\
Converting back to the areal radius to see the graphs and if it is different\
\>", "Subsubsection",
 CellChangeTimes->{{3.979742050307272*^9, 3.979742076927948*^9}, {
  3.979743799063179*^9, 
  3.9797438051640453`*^9}},ExpressionUUID->"71e1bab6-036d-4299-9faf-\
009da95e5275"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Areal", " ", "radius", " ", "as", " ", "a", " ", "function", " ", "of", " ",
     "isotropic", " ", "radius"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"rFromRbar", "[", "rbar_", "]"}], ":=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"A", "[", "rbar", "]"}], "*", "rbar"}], ",", 
          RowBox[{"rbar", ">=", "rbarStar"}]}], "}"}], ",", 
        RowBox[{"(*", "exterior", "*)"}], 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"AInside", "[", "rbar", "]"}], "*", "rbar"}], ",", 
          RowBox[{"rbar", "<", "rbarStar"}]}], "}"}]}], "    ", 
       RowBox[{"(*", "interior", "*)"}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Areal", " ", "radius", " ", "along", " ", "the", " ", "orbit"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"arealr", "[", "t_", "]"}], ":=", 
     RowBox[{"rFromRbar", "[", 
      RowBox[{"rbarNumIn", "[", "t", "]"}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.979742229262013*^9, 3.979742295009645*^9}, {
  3.979742342432342*^9, 3.979742365872905*^9}, {3.97974240807908*^9, 
  3.9797424084926853`*^9}, {3.979742475262102*^9, 3.979742504402256*^9}, {
  3.9797427606342077`*^9, 3.9797427648932753`*^9}, {3.979743386095112*^9, 
  3.9797433864274178`*^9}, {3.979743472807996*^9, 3.979743475754581*^9}},
 CellLabel->
  "In[168]:=",ExpressionUUID->"e73543dc-f651-443b-a602-c39dcdc90649"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"x", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"arealr", "[", "t", "]"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"phiNumIn", "[", "t", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"y", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"arealr", "[", "t", "]"}], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"phiNumIn", "[", "t", "]"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.979742774293977*^9, 3.979742775136449*^9}, {
  3.979743389786322*^9, 3.979743391409541*^9}},
 CellLabel->
  "In[170]:=",ExpressionUUID->"e8f70c7a-bc65-4c95-8418-e014368e3be6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"orbit2D", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "[", "t", "]"}], ",", 
       RowBox[{"y", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "t0", ",", 
       RowBox[{"0.999", " ", "tFinish"}]}], "}"}], ",", 
     RowBox[{"AspectRatio", "->", "1"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Blue"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.979559828063959*^9, 3.979559833895805*^9}, {
  3.9797425311876307`*^9, 3.979742538139497*^9}, {3.979742716868277*^9, 
  3.979742717822167*^9}, {3.979742782200715*^9, 3.979742783471751*^9}, {
  3.979742817552215*^9, 3.979742820743737*^9}},
 CellLabel->
  "In[172]:=",ExpressionUUID->"fb24f4ba-6bde-4ec3-a9ed-779d5095ec08"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Areal", " ", "radius", " ", "of", " ", "the", " ", "stellar", " ", 
    "surface"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"rstarAreal", "=", 
     RowBox[{
      RowBox[{"A", "[", "rbarStar", "]"}], " ", "rbarStar"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"centralBody", "=", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GrayLevel", "[", "0.9", "]"}], ",", 
        RowBox[{"Disk", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", "rstarAreal"}], "]"}]}], 
       "}"}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9797428229566517`*^9, 3.979742835417776*^9}, {
  3.97974332393603*^9, 3.979743370159604*^9}},
 CellLabel->
  "In[173]:=",ExpressionUUID->"75a3cccb-45ee-4b53-8ca7-571b5ec1ae46"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"centralBody", ",", " ", "orbit2D", ",", 
   RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", " ", 
   RowBox[{"Axes", " ", "->", " ", "True"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.979743489322414*^9, 3.979743494676199*^9}, {
  3.979743526579563*^9, 3.979743529992216*^9}},
 CellLabel->
  "In[175]:=",ExpressionUUID->"4eb1486b-99e8-4848-ac2b-0dbcca1fd2c7"],

Cell[TextData[{
 "Initially though that it was stopping because the velocities were zero and \
that it was at the centre, which turned out to be naive, checked the value or \
rbarNumIn and this showed that it was not at zero, and it is the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["u", "3"], TraditionalForm]],ExpressionUUID->
  "023ef39f-a711-4168-83bc-dc0f04e69512"],
 " term once again causing this artificial, fictitious behaviour as a result \
of the coordinate choices I assume.\nIn reflection, it cannot be a \
singularity here and it a result of numerical stiffness build up in the \
integration "
}], "Text",
 CellChangeTimes->{{3.979743979634658*^9, 3.979744065412425*^9}, {
  3.97979805525603*^9, 
  3.9797980853547783`*^9}},ExpressionUUID->"d891f8d1-51b8-48c5-acc9-\
c1be3dbeec67"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Capturing the PBH from infinity", "Subsection",
 CellChangeTimes->{{3.9804146308308077`*^9, 
  3.980414645960281*^9}},ExpressionUUID->"97671731-2eec-4b8f-b41d-\
55dba966f53a"],

Cell["\<\
Assuming PBH comes from infinity and just hits in and enters the star\
\>", "Text",
 CellChangeTimes->{{3.9804150369994*^9, 
  3.980415056490988*^9}},ExpressionUUID->"f1abbc9b-aebf-4462-bd14-\
c681eb195398"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Approaching the problem differently, using ", "Text"],
 StyleBox["Keplerian", "Text",
  IgnoreSpellCheck->True],
 StyleBox[" orbits on the outside of the star and then GR on the inside to \
reduce the stiffness of the problem causing the error in the solver.", 
  "Text"]
}], "Subsubsection",
 CellChangeTimes->{{3.979808250472919*^9, 3.9798082843297377`*^9}, {
  3.980414653959667*^9, 3.980414654081059*^9}, {3.980415675997685*^9, 
  3.9804156766256523`*^9}},ExpressionUUID->"b6603694-3cc2-4db1-aa87-\
571acf8d2183"],

Cell[TextData[{
 "Setting v_inf to something physical is essential, most dark matter comes \
from the galactic halo, where things move at roughly 200km/s so with setting \
c = 1, vinf should be ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ffa5a446-0a3e-400b-8b04-8e0dafe4b1ed"],
 " which implies the Energy at infinity should be approximately equal to 1 \
and very little energy loss is needed to bound the orbit."
}], "Text",
 CellChangeTimes->{{3.9804169280841722`*^9, 3.980416975800755*^9}, {
  3.980417052878079*^9, 
  3.980417091913995*^9}},ExpressionUUID->"e5549518-9822-4339-8825-\
de98752a6517"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Defining Initial Data Functions", "Subsubsection",
 CellChangeTimes->{{3.980417361129909*^9, 
  3.9804173686441803`*^9}},ExpressionUUID->"3742578b-7ab3-4064-bd9b-\
658aee016464"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vinf", " ", "=", " ", 
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.980417096758354*^9, 3.9804171019450607`*^9}},
 CellLabel->
  "In[176]:=",ExpressionUUID->"a38faf4c-d76b-4470-95be-deb12d46599a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"InitialEnergyAtInfinity", "[", "vinf_", "]"}], " ", ":=", " ", 
    FractionBox["1", 
     SqrtBox[
      RowBox[{"1", " ", "-", " ", 
       SuperscriptBox["vinf", "2"]}]]]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"eq47", " ", "2404", " ", "paper"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.9804160850197678`*^9, 3.980416098649988*^9}},
 CellLabel->
  "In[177]:=",ExpressionUUID->"e612bdc4-861a-4b86-8b55-324028654924"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "general", " ", "formula", " ", "for", " ", "the", " ", "magnitude", " ", 
     "of", " ", "the", " ", "velocity"}], ",", " ", 
    RowBox[{
    "for", " ", "a", " ", "general", " ", "spherically", " ", "symmetric", " ",
      "Isotropic", " ", "metric"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"umagVel", "[", 
     RowBox[{"ur_", ",", " ", "uphi_", ",", " ", "rbar_"}], "]"}], " ", ":=", 
    " ", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["ur", "2"], " ", "+", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["uphi", "rbar"], ")"}], "2"]}]]}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"umagE", "[", 
      RowBox[{"Energy_", ",", " ", "rbar_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"A", "[", "rbar", "]"}], 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["Energy", 
           RowBox[{"\[Alpha]", "[", "rbar", "]"}]], ")"}], "2"], " ", "-", 
        " ", "1"}]]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"eq", " ", "48", " ", "in", " ", "paper"}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.980415761538435*^9, 3.9804158755202312`*^9}, {
  3.9804159272169247`*^9, 3.980415932674501*^9}, {3.980415969031563*^9, 
  3.980415973297673*^9}, {3.980416194586721*^9, 3.9804162406179028`*^9}, {
  3.980418347236079*^9, 3.980418358959013*^9}, {3.9804201609992113`*^9, 
  3.980420171909109*^9}},
 CellLabel->
  "In[178]:=",ExpressionUUID->"2b9557c4-49b2-4338-b6d6-3d6feea0dfdb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Defining", " ", "the", " ", "Impact", " ", "angle"}], ",", " ", 
    RowBox[{
    "which", " ", "is", " ", "the", " ", "angle", " ", "between", " ", "the", 
     " ", "radial", " ", "vector", " ", "and", " ", "the", " ", 
     RowBox[{"PBH", "'"}], "s", " ", "velocity", " ", "vector"}]}], "*)"}], 
  " ", 
  RowBox[{"(*", 
   RowBox[{
   "It", " ", "is", " ", "the", " ", "angle", " ", "the", " ", "PBH", " ", 
    "enters", " ", "the", " ", "star"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"urInit", "[", 
      RowBox[{"psi_", ",", " ", "Einit_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"umagE", "[", 
        RowBox[{"Einit", " ", ",", " ", "rbarStar"}], "]"}]}], 
      RowBox[{"Cos", "[", "psi", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"uphiInit", "[", 
      RowBox[{"psi_", ",", " ", "rbarStar_", ",", " ", "Einit_"}], "]"}], " ",
      ":=", " ", 
     RowBox[{"rbarStar", " ", 
      RowBox[{"umagE", "[", "Einit", " ", "]"}], 
      RowBox[{"Sin", "[", "psi", "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Is", " ", "defining", " ", "angular", " ", "momentum"}], ",", 
     " ", 
     RowBox[{"L", " ", "is", " ", "equal", " ", "to", " ", "this"}]}], 
    "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.98041633503653*^9, 3.980416355465521*^9}, {
  3.98041639081736*^9, 3.980416540208694*^9}, {3.980416606116276*^9, 
  3.9804166267383633`*^9}, {3.980416666749844*^9, 3.980416673625964*^9}, {
  3.980417116639278*^9, 3.9804171875471582`*^9}, {3.980417225602989*^9, 
  3.980417287800577*^9}, {3.9804176328755302`*^9, 3.98041763616606*^9}, {
  3.980418073144514*^9, 3.980418193394154*^9}, {3.980418470589699*^9, 
  3.980418473698866*^9}, {3.980418515413982*^9, 3.980418541360607*^9}, {
  3.980418658653262*^9, 3.980418733921682*^9}, {3.980420231879798*^9, 
  3.9804202353180428`*^9}},
 CellLabel->
  "In[180]:=",ExpressionUUID->"f1cc6208-1587-4fc9-8015-8c76c9024271"]
