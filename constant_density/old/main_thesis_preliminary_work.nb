              RowBox[{
               RowBox[{"rbar", "[", "t", "]"}], " ", ">=", " ", 
               "rbarStar"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"durdtInside", "[", 
               RowBox[{
                RowBox[{"rbar", "[", "t", "]"}], ",", " ", 
                RowBox[{"ur", "[", "t", "]"}]}], "]"}], ",", " ", 
              RowBox[{
               RowBox[{"rbar", "[", "t", "]"}], " ", "<", " ", "rbarStar"}]}],
              "}"}]}], "}"}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"rbar", "[", "0", "]"}], " ", "==", " ", "rbar0"}], ",", " ", 
        RowBox[{
         RowBox[{"ur", "[", "0", "]"}], " ", "==", " ", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Center", " ", "velocity", " ", "switch"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"WhenEvent", "[", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"rbar", "[", "t", "]"}], " ", "<=", " ", "rStop"}], ",", 
          " ", 
          RowBox[{
           RowBox[{"ur", "[", "t", "]"}], " ", "->", " ", 
           RowBox[{"-", 
            RowBox[{"ur", "[", "t", "]"}]}]}]}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"rbar", ",", " ", "ur"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "t0", ",", " ", "tEnd"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Mathematica", " ", "used", " ", "to", " ", "solving", " ", "ODEs", " ", 
     "forward", " ", "in", " ", "time", " ", "or", " ", "from", " ", "left", " ",
      "to", " ", "right"}], ",", " ", 
    RowBox[{
     RowBox[{"so", " ", "impose", " ", "at", " ", "the", " ", "ur"}], " ", "=",
      " ", 
     RowBox[{
     "0", " ", "turning", " ", "point", " ", "outside", " ", "the", " ", 
      "star", " ", "that", " ", "the", " ", "odes", " ", "change", " ", 
      "accordingly", " ", "and", " ", "the", " ", "sign", " ", "flips", " ", 
      "to", " ", "give", " ", "it", " ", "no", " ", "ambiguity", " ", "and", " ",
       "to", " ", "stop", " ", "it", " ", "from", " ", "breaking"}]}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Inputted", " ", "less", " ", "stringent", " ", "criteria", " ", "on", " ",
     "rbar", " ", "in", " ", "the", " ", "WhenEvent", " ", 
