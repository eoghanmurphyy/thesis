Cell[BoxData[{
 RowBox[{"NumericQ", "@", 
  RowBox[{"tauIsotropic", "[", 
   RowBox[{"rbar0", ",", " ", "rbarStar"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Check proper time equality: \>\"", ",", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"tauSchw", "[", 
         RowBox[{"R0", ",", "RStar"}], "]"}], "/", 
