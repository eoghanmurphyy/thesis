Cell["\<\
Defining the Isotropic metric components for external Schwarzschild spacetime\
\
\>", "Text",
 CellChangeTimes->{{3.978080680202964*^9, 3.978080698553022*^9}, {
  3.978268989555698*^9, 
  3.9782689965556726`*^9}},ExpressionUUID->"5b9b60d0-0c1f-4469-a1af-\
61be65f73c12"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "[", "rbar_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", " ", "+", " ", 
     RowBox[{"M", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "rbar"}], ")"}]}]}], ")"}], "^", "2"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]", "[", "rbar_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", " ", "-", " ", 
     RowBox[{"M", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "rbar"}], ")"}]}]}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{"1", " ", "+", " ", 
     RowBox[{"M", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "rbar"}], ")"}]}]}], ")"}]}]}]}], "Input",
 CellChangeTimes->{{3.978080703602681*^9, 3.9780808115943537`*^9}, {
  3.980420042256241*^9, 3.980420043437194*^9}, {3.984232603016873*^9, 
  3.984232609984437*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"5d15e3dc-ab5f-454a-a724-8b2bc3b93d2c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tauSchw", "[", 
    RowBox[{"RStart_", ",", " ", "rFinish_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", " ", "M"}], "]"}]}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"rFinish", " ", "RStart", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"1", "/", "rFinish"}], " ", "-", " ", 
         RowBox[{"1", "/", "RStart"}]}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"RStart", "^", 
        RowBox[{"(", 
         RowBox[{"3", "/", "2"}], ")"}]}], " ", 
       RowBox[{"ArcTan", "[", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"RStart", "/", "rFinish"}], " ", "-", " ", "1"}], "]"}], 
        "]"}]}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.978269325769779*^9, 3.9782693302099333`*^9}, {
  3.978269364001452*^9, 3.978269367337305*^9}, {3.984232676360569*^9, 
  3.984232681200364*^9}, {3.9842330107184887`*^9, 3.9842330299024487`*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"0aa1fae6-8242-4b98-bb4e-ed8db12428d0"],

