Cell[CellGroupData[{

Cell["Inside Star", "Subsubsection",
 CellChangeTimes->{{3.978425349818738*^9, 
  3.978425364686689*^9}},ExpressionUUID->"11e88fd0-b277-422c-b873-\
1648adcccd94"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"UtInside", "[", 
    RowBox[{"rbar_", ",", " ", "ur_", ",", " ", "uphi_"}], "]"}], " ", "=", 
   " ", 
   FractionBox[
    SqrtBox[
     RowBox[{"1", " ", "+", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["ur", 
         RowBox[{"AInside", "[", "rbar", "]"}]], ")"}], "2"], " ", "+", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["uphi", 
         RowBox[{"rbar", " ", 
          RowBox[{"AInside", "[", "rbar", "]"}]}]], ")"}], "2"]}]], 
    RowBox[{"\[Alpha]Inside", "[", "rbar", "]"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Epsilon]", " ", "=", " ", 
    SuperscriptBox["10", 
     RowBox[{"-", "1"}]]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"regularisation", " ", "parameter"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]", " ", "=", " ", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"umagphi", "[", 
     RowBox[{"rbar_", ",", " ", "ur_", ",", " ", "uphi_"}], "]"}], " ", "=", 
    " ", 
    FractionBox[
     SqrtBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["ur", "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["uphi", "rbar"], ")"}], "2"]}], ")"}]], 
     RowBox[{"AInside", "[", "rbar", "]"}]]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"paper", " ", "eqn", " ", "ut", " ", "and", " ", "umagphi"}], 
   "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"drBardtInside", "[", 
     RowBox[{"rbar_", ",", " ", "ur_", ",", " ", "uphi_"}], "]"}], " ", "=", 
    " ", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"AInside", "[", "rbar", "]"}], "2"], 
       RowBox[{"UtInside", "[", 
        RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}]}]], 
     "ur"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dphidtInside", "[", 
     RowBox[{"rbar_", ",", " ", "ur_", ",", " ", "uphi_"}], "]"}], " ", "=", 
    " ", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       SuperscriptBox["rbar", "2"], 
       SuperscriptBox[
        RowBox[{"AInside", "[", "rbar", "]"}], "2"], 
       RowBox[{"UtInside", "[", 
        RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}]}]], 
     "uphi"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dpdtdragphi", "[", 
     RowBox[{"rbar_", ",", " ", "ur_", ",", " ", "uphi_"}], "]"}], " ", "=", 
    " ", 
    RowBox[{
     FractionBox["1", 
      SuperscriptBox[
       RowBox[{"umagphi", "[", 
        RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], "3"]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "4"}], "\[Pi]", " ", 
       RowBox[{"\[Alpha]Inside", "[", "rbar", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"\[Rho]", " ", "+", " ", 
         RowBox[{"P", "[", "rbar", "]"}]}], ")"}], "*", 
       SuperscriptBox["m", "2"], "*", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"2", " ", 
           SuperscriptBox[
            RowBox[{"umagphi", "[", 
             RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], 
            "2"]}]}], ")"}], "2"], " ", "*", "Ivariable", " ", "*", "uphi"}], 
      ")"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"duphidtInside", "[", 
     RowBox[{"rbar_", ",", " ", "ur_", ",", " ", "uphi_"}], "]"}], " ", "=", 
    " ", 
    RowBox[{
     FractionBox["\[Eta]", "m"], 
     RowBox[{"(", 
      RowBox[{"dpdtdragphi", "[", 
       RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], ")"}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dpdtdragr", "[", 
     RowBox[{"rbar_", ",", " ", "ur_", ",", " ", "uphi_"}], "]"}], " ", "=", 
    " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "4"}], "\[Pi]", " ", 
       RowBox[{"\[Alpha]Inside", "[", "rbar", "]"}], 
       RowBox[{"(", 
        RowBox[{"\[Rho]", " ", "+", " ", 
         RowBox[{"P", "[", "rbar", "]"}]}], ")"}], 
       SuperscriptBox["m", "2"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"2", " ", 
           SuperscriptBox[
            RowBox[{"umagphi", "[", 
             RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], 
            "2"]}]}], ")"}], "2"], " ", "Ivariable", " ", "ur"}], ")"}], "/", 
     
     SuperscriptBox[
      RowBox[{"umagphi", "[", 
       RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], "3"]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"durdt2DInside", "[", 
    RowBox[{"rbar_", ",", " ", "ur_", ",", " ", "uphi_"}], "]"}], " ", "=", 
   " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"\[Alpha]Inside", "[", "rbar", "]"}]}], " ", 
     RowBox[{"UtInside", "[", 
      RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Derivative", "[", "1", "]"}], "[", "\[Alpha]Inside", "]"}], "[",
       "rbar", "]"}]}], " ", "+", " ", 
    RowBox[{
     FractionBox[
      SuperscriptBox["ur", "2"], 
      RowBox[{"UtInside", "[", 
       RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}]], 
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "AInside", "]"}], "[", 
        "rbar", "]"}], 
       SuperscriptBox[
        RowBox[{"AInside", "[", "rbar", "]"}], "3"]], ")"}]}], " ", "+", " ", 
    
    RowBox[{
     FractionBox[
      SuperscriptBox["uphi", "2"], 
      RowBox[{"UtInside", "[", 
       RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}]], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", 
        RowBox[{
         SuperscriptBox["rbar", "3"], 
         SuperscriptBox[
          RowBox[{"AInside", "[", "rbar", "]"}], "2"]}]], " ", "+", " ", 
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", "1", "]"}], "[", "AInside", "]"}], "[", 
         "rbar", "]"}], 
        RowBox[{
         SuperscriptBox["rbar", "2"], 
         SuperscriptBox[
          RowBox[{"AInside", "[", "rbar", "]"}], "3"]}]]}], ")"}]}], " ", "+",
     "  ", 
    RowBox[{
     FractionBox["\[Eta]", "m"], 
     RowBox[{"(", 
      RowBox[{"dpdtdragr", "[", 
       RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], ")"}]}]}]}],
   ";"}]}], "Input",
 CellChangeTimes->{{3.978424795478031*^9, 3.978424796622242*^9}, {
   3.978425371289625*^9, 3.9784253812947493`*^9}, {3.978425414050268*^9, 
