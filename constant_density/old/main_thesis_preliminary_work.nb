          RowBox[{"2", " ", 
           SuperscriptBox[
            RowBox[{"umagphi", "[", 
             RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], 
            "2"]}]}], ")"}], "2"], " ", "*", "Ivariable", " ", "*", "uphi"}], 
      ")"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
