Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"m", " ", "=", " ", 
    SuperscriptBox["10", 
     RowBox[{"-", "6"}]]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"mass", " ", "of", " ", 
    RowBox[{"PBH", "?"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ivariable", " ", "=", " ", "10"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"??", 
    RowBox[{
     RowBox[{"?", " ", 
      RowBox[{"Just", " ", "got", " ", "from", " ", "paper"}]}], ",", " ", 
     RowBox[{
     "something", " ", "got", " ", "to", " ", "do", " ", "with", " ", 
      "Coulomb", " ", "something", " ", "or", " ", "other"}]}]}], "*)"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]", " ", "=", " ", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", 
    RowBox[{"rbar_", ",", " ", "ur_"}], "]"}], " ", "=", " ", 
   FractionBox[
    RowBox[{"Abs", "[", "ur", "]"}], 
    RowBox[{"AInside", "[", "rbar", "]"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"P", "[", "rbar_", "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"\[Rho]", 
      RowBox[{"(", 
       FractionBox[
        RowBox[{
         SqrtBox[
