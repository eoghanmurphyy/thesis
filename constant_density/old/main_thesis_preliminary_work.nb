    FractionBox[
     SqrtBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["ur", "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["uphi", "rbar"], ")"}], "2"]}], ")"}]], 
     RowBox[{"AInside", "[", "rbar", "]"}]]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"paper", " ", "eqn", " ", "ut", " ", "and", " ", "umagphi"}], 
   "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
