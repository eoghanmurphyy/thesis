bee18fc02971"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ALim0", " ", "=", " ", 
   RowBox[{
    RowBox[{"Limit", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{"AInside", "[", "rbar", "]"}], ",", " ", 
          RowBox[{"{", 
