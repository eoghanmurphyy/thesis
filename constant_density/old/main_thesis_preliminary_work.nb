  3.979556662697955*^9}},ExpressionUUID->"e045b394-73fc-4f09-b4c2-\
44f25ac06128"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"t0", " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tEnd", " ", "=", " ", "2500"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rStop", " ", "=", " ", 
    SuperscriptBox["10", 
     RowBox[{"-", "4"}]]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"solIn", " ", "=", " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"rbar", "'"}], "[", "t", "]"}], " ", "==", 
          RowBox[{"Piecewise", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"drBardt", "[", 
                RowBox[{
                 RowBox[{"rbar", "[", "t", "]"}], ",", " ", 
                 RowBox[{"ur", "[", "t", "]"}]}], "]"}], ",", " ", 
               RowBox[{
                RowBox[{"rbar", "[", "t", "]"}], " ", ">=", " ", 
                "rbarStar"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"drBardtInside", "[", 
                RowBox[{
                 RowBox[{"rbar", "[", "t", "]"}], ",", " ", 
                 RowBox[{"ur", "[", "t", "]"}]}], "]"}], ",", " ", 
               RowBox[{
                RowBox[{"rbar", "[", "t", "]"}], " ", "<", " ", 
                "rbarStar"}]}], "}"}]}], "}"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"ur", "'"}], "[", "t", "]"}], " ", "==", " ", 
          RowBox[{"Piecewise", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
