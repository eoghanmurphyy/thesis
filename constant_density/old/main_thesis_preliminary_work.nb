        RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}]}]], 
     "uphi"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dpdtdragphi", "[", 
     RowBox[{"rbar_", ",", " ", "ur_", ",", " ", "uphi_"}], "]"}], " ", "=", 
    " ", 
    RowBox[{
     FractionBox["1", 
      SuperscriptBox[
       RowBox[{"umagphi", "[", 
        RowBox[{"rbar", ",", " ", "ur", ",", " ", "uphi"}], "]"}], "3"]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "4"}], "\[Pi]", " ", 
       RowBox[{"\[Alpha]Inside", "[", "rbar", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"\[Rho]", " ", "+", " ", 
         RowBox[{"P", "[", "rbar", "]"}]}], ")"}], "*", 
       SuperscriptBox["m", "2"], "*", 
