     RowBox[{
      RowBox[{"rFinish", " ", "RStart", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"1", "/", "rFinish"}], " ", "-", " ", 
         RowBox[{"1", "/", "RStart"}]}], "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"RStart", "^", 
        RowBox[{"(", 
         RowBox[{"3", "/", "2"}], ")"}]}], " ", 
       RowBox[{"ArcTan", "[", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"RStart", "/", "rFinish"}], " ", "-", " ", "1"}], "]"}], 
        "]"}]}]}], ")"}]}]}], ";"}]], "Input",
