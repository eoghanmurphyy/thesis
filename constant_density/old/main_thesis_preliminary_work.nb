         RowBox[{"rbar0", ",", "rbarStar"}], "]"}]}]}], "]"}], "<", 
     SuperscriptBox["10", 
      RowBox[{"-", "16"}]]}]}], "]"}], " ", 
  RowBox[{"(*", 
