Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"centralBody", ",", " ", "orbit2D", ",", 
   RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", " ", 
   RowBox[{"Axes", " ", "->", " ", "True"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.979743489322414*^9, 3.979743494676199*^9}, {
  3.979743526579563*^9, 3.979743529992216*^9}},
 CellLabel->
  "In[175]:=",ExpressionUUID->"4eb1486b-99e8-4848-ac2b-0dbcca1fd2c7"],

Cell[TextData[{
 "Initially though that it was stopping because the velocities were zero and \
that it was at the centre, which turned out to be naive, checked the value or \
rbarNumIn and this showed that it was not at zero, and it is the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["u", "3"], TraditionalForm]],ExpressionUUID->
  "023ef39f-a711-4168-83bc-dc0f04e69512"],
 " term once again causing this artificial, fictitious behaviour as a result \
of the coordinate choices I assume.\nIn reflection, it cannot be a \
singularity here and it a result of numerical stiffness build up in the \
integration "
}], "Text",
 CellChangeTimes->{{3.979743979634658*^9, 3.979744065412425*^9}, {
  3.97979805525603*^9, 
  3.9797980853547783`*^9}},ExpressionUUID->"d891f8d1-51b8-48c5-acc9-\
c1be3dbeec67"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Capturing the PBH from infinity", "Subsection",
 CellChangeTimes->{{3.9804146308308077`*^9, 
  3.980414645960281*^9}},ExpressionUUID->"97671731-2eec-4b8f-b41d-\
55dba966f53a"],

Cell["\<\
Assuming PBH comes from infinity and just hits in and enters the star\
\>", "Text",
 CellChangeTimes->{{3.9804150369994*^9, 
  3.980415056490988*^9}},ExpressionUUID->"f1abbc9b-aebf-4462-bd14-\
c681eb195398"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Approaching the problem differently, using ", "Text"],
 StyleBox["Keplerian", "Text",
  IgnoreSpellCheck->True],
 StyleBox[" orbits on the outside of the star and then GR on the inside to \
reduce the stiffness of the problem causing the error in the solver.", 
  "Text"]
}], "Subsubsection",
 CellChangeTimes->{{3.979808250472919*^9, 3.9798082843297377`*^9}, {
  3.980414653959667*^9, 3.980414654081059*^9}, {3.980415675997685*^9, 
  3.9804156766256523`*^9}},ExpressionUUID->"b6603694-3cc2-4db1-aa87-\
571acf8d2183"],

Cell[TextData[{
 "Setting v_inf to something physical is essential, most dark matter comes \
from the galactic halo, where things move at roughly 200km/s so with setting \
c = 1, vinf should be ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ffa5a446-0a3e-400b-8b04-8e0dafe4b1ed"],
 " which implies the Energy at infinity should be approximately equal to 1 \
and very little energy loss is needed to bound the orbit."
}], "Text",
 CellChangeTimes->{{3.9804169280841722`*^9, 3.980416975800755*^9}, {
  3.980417052878079*^9, 
  3.980417091913995*^9}},ExpressionUUID->"e5549518-9822-4339-8825-\
de98752a6517"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Defining Initial Data Functions", "Subsubsection",
 CellChangeTimes->{{3.980417361129909*^9, 
  3.9804173686441803`*^9}},ExpressionUUID->"3742578b-7ab3-4064-bd9b-\
658aee016464"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vinf", " ", "=", " ", 
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.980417096758354*^9, 3.9804171019450607`*^9}},
 CellLabel->
  "In[176]:=",ExpressionUUID->"a38faf4c-d76b-4470-95be-deb12d46599a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"InitialEnergyAtInfinity", "[", "vinf_", "]"}], " ", ":=", " ", 
    FractionBox["1", 
     SqrtBox[
      RowBox[{"1", " ", "-", " ", 
       SuperscriptBox["vinf", "2"]}]]]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"eq47", " ", "2404", " ", "paper"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.9804160850197678`*^9, 3.980416098649988*^9}},
 CellLabel->
  "In[177]:=",ExpressionUUID->"e612bdc4-861a-4b86-8b55-324028654924"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "general", " ", "formula", " ", "for", " ", "the", " ", "magnitude", " ", 
     "of", " ", "the", " ", "velocity"}], ",", " ", 
    RowBox[{
    "for", " ", "a", " ", "general", " ", "spherically", " ", "symmetric", " ",
      "Isotropic", " ", "metric"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"umagVel", "[", 
     RowBox[{"ur_", ",", " ", "uphi_", ",", " ", "rbar_"}], "]"}], " ", ":=", 
    " ", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["ur", "2"], " ", "+", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["uphi", "rbar"], ")"}], "2"]}]]}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"umagE", "[", 
      RowBox[{"Energy_", ",", " ", "rbar_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"A", "[", "rbar", "]"}], 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["Energy", 
           RowBox[{"\[Alpha]", "[", "rbar", "]"}]], ")"}], "2"], " ", "-", 
        " ", "1"}]]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"eq", " ", "48", " ", "in", " ", "paper"}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.980415761538435*^9, 3.9804158755202312`*^9}, {
  3.9804159272169247`*^9, 3.980415932674501*^9}, {3.980415969031563*^9, 
  3.980415973297673*^9}, {3.980416194586721*^9, 3.9804162406179028`*^9}, {
  3.980418347236079*^9, 3.980418358959013*^9}, {3.9804201609992113`*^9, 
  3.980420171909109*^9}},
 CellLabel->
  "In[178]:=",ExpressionUUID->"2b9557c4-49b2-4338-b6d6-3d6feea0dfdb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Defining", " ", "the", " ", "Impact", " ", "angle"}], ",", " ", 
    RowBox[{
    "which", " ", "is", " ", "the", " ", "angle", " ", "between", " ", "the", 
     " ", "radial", " ", "vector", " ", "and", " ", "the", " ", 
     RowBox[{"PBH", "'"}], "s", " ", "velocity", " ", "vector"}]}], "*)"}], 
  " ", 
  RowBox[{"(*", 
   RowBox[{
   "It", " ", "is", " ", "the", " ", "angle", " ", "the", " ", "PBH", " ", 
    "enters", " ", "the", " ", "star"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"urInit", "[", 
      RowBox[{"psi_", ",", " ", "Einit_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"umagE", "[", 
        RowBox[{"Einit", " ", ",", " ", "rbarStar"}], "]"}]}], 
      RowBox[{"Cos", "[", "psi", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"uphiInit", "[", 
      RowBox[{"psi_", ",", " ", "rbarStar_", ",", " ", "Einit_"}], "]"}], " ",
      ":=", " ", 
     RowBox[{"rbarStar", " ", 
      RowBox[{"umagE", "[", "Einit", " ", "]"}], 
      RowBox[{"Sin", "[", "psi", "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Is", " ", "defining", " ", "angular", " ", "momentum"}], ",", 
